/// Hong 11/07/07 v8.0742 FIX_EXP_GRAPH_FAIL_COMPILE
#ifdef _FOR_SMART_LOADING_ONLY
#include <..\originlab\AxisScrollbar.h>
#include <..\originlab\grobj_utils.h>
#endif //_FOR_SMART_LOADING_ONLY
/// end FIX_EXP_GRAPH_FAIL_COMPILE
#include <..\Originlab\GraphicalExport.h>

//#define _TEST_SPEED
#ifdef _TEST_SPEED
#include <profiler.h> //CPY 4/23/07 
#endif // _TEST_SPEED

/**
 *	Modification Log:
 	/// Hong 04/13/09 QA80-13280 EXP_SINGLE_WKS_TO_MILTI_PAGES_PDF
 	/// Hong 06/16/09 FIX_DPI_SETTING_IS_LOST_AFTER_CLICK_OK
 	/// Hong 07/21/09 QA80-13280-P4 WKS_EXPORT_MULTIPAGE_PDF_PAGE_BREAKS
 	/// Hong 09/18/09 FIX_FAIL_DESTROY_STATIC_OBJECT_IF_CLOSE_EXPPDFW_LEAD_EXPGRAPH_FAIL_TO_OPEN
*/


//static CGraphicalExportWksEx 	s_wksExport;

///------ Folger 06/21/2017 ORG-15841-P3 ALLOW_XF_UPDATE_GETN_BEFORE_GENERATE_SCRIPT
void expPDFw_GenerateScriptUpdateGetN(TreeNode& trGetN)
{
	GenerateScriptUpdateGetN(trGetN);
}
///------ End ALLOW_XF_UPDATE_GETN_BEFORE_GENERATE_SCRIPT
]]>
