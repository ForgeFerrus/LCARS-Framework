		<code NodeID="45" DataID="325" MultilineEditExpShrink="1" DispFormat="33554432" RowHeightRange="5-20">
			<![CDATA[/// Hong 04/13/09 QA80-13280 EXP_SINGLE_WKS_TO_MILTI_PAGES_PDF
//InvokeExpGraph(type, export, pages, filename, path, overwrite, sysopts, tr, keepsize, tr1, tr2);
InvokeExpGraph(type, export, pages, filename, path, overwrite, sysopts, tr, keepsize, tr1, tr2, NULL, true);
/// end EXP_SINGLE_WKS_TO_MILTI_PAGES_PDF]]>
		</code>
		<event1 NodeID="45" DataID="327" MultilineEditExpShrink="1" DispFormat="33554432" RowHeightRange="5-20" Show="0">
			<![CDATA[/// Hong 06/16/09 FIX_DPI_SETTING_IS_LOST_AFTER_CLICK_OK
if ( GETNE_ON_OK == nEventID )
	return true;
/// end FIX_DPI_SETTING_IS_LOST_AFTER_CLICK_OK

///Kyle 09/24/08 SET_NO_NEED_TO_LOCALIZE
if ( GETNE_ON_INIT == nEventID )
{
	trGetN.type.SetAttribute(STR_OCNTRL_OPTNS, OCNTRLPARAM1_NOT_LOCALIZED);
	///Sophy 12/16/2011 ORG-4633-P1 EXPORT_MULTI_PDF_NEED_PROJECT_FOLDER_PATH_COMBO
	TreeNode trPath = trGetN.path;
	if ( trPath.strVal.IsEmpty() )
	{
		trPath.strVal = GetAppPath(false); //user file folder
	}
	tree_set_browse_combo_attrib(trPath, NULL, true, false);
	///end EXPORT_MULTI_PDF_NEED_PROJECT_FOLDER_PATH_COMBO
	///---Sim 2015-08-28 ORG-12798 FIX_EXP_ASC_GUI_HAND_ON_IF_FILE_PATH_IS_EMPTY
	octree_modify_attribute(&trPath, STR_OCNTRL_OPTNS, OCNTRLPARAM1_NO_TIMER_ON_EDIT_CHANGE, 0);
	///---END ORG-12798 FIX_EXP_ASC_GUI_HAND_ON_IF_FILE_PATH_IS_EMPTY
}
///End SET_NO_NEED_TO_LOCALIZE
TreeNode			trNode;
trNode = tree_get_node_by_tagname(trGetN, lpcszNodeName, true);
DWORD				dwUpdateGraph;
/// Hong 07/21/09 QA80-13280-P4 WKS_EXPORT_MULTIPAGE_PDF_PAGE_BREAKS
//InvokeOnChange(trGetN, trNode, dwUpdateGraph, dwEnables, strErrMsg);
InvokeOnChange(trGetN, trNode, dwUpdateGraph, dwEnables, strErrMsg, true);
/// end WKS_EXPORT_MULTIPAGE_PDF_PAGE_BREAKS

return true;	]]>
