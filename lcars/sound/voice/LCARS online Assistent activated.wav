Max 2/21/2012 ORG-5113 update label for &quot;export&quot;</modificationLog>
	<codes NodeID="268435456" DataID="324">
		<rettype NodeID="11" Combo="void|int|double|string|vector" DataID="41">void</rettype>
		<header NodeID="45" DataID="323" MultilineEditExpShrink="1" DispFormat="33554432" RowHeightRange="3-15">
			<![CDATA[//put additional include files here
#include <image_utils.h>
#include <okocUtils.h>
#include <..\OriginLab\PathTrack.h>

#include <..\Originlab\ODlg8.h> ///---Sim 08-16-2007 ADD_MORE_OPTIONS_ON_OVER_WRITE
#include <control.h>
#include <ocGDI.h> //------- CPY 10/6/06 EMF_PREVIEW
