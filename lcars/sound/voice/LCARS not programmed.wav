///Jasmine 02/24/09 PROTECT_LOCALIZATION_FOLDER
static string _get_localization_folder()
{
	string strLocalization = okutil_get_language_path(true);
	strLocalization = GetAppPath(true) + strLocalization.GetToken(0, OFSEP) + OFSEPS;
	strLocalization.MakeUpper();
	
	return strLocalization;
}
///End PROTECT_LOCALIZATION_FOLDER

///Jasmine 02/17/09 SHOW_BUILT_IN_MEG_FOR_ALL_TEMPLATE_IN_EXE_FOLDER
static bool _override_exe_folder(LPCSTR lpcszFile)
{
	string strFolder = GetFilePath(lpcszFile);
	if(lstrcmpi(strFolder, STR_USER_PATH) == 0 || lstrcmpi(strFolder, STR_SYSTEM_PATH) == 0)
	{
		string strExeFile = STR_SYSTEM_PATH + GetFileName(lpcszFile);
		if( strExeFile.IsFile() )
			return true;
		
		///Jasmine 02/24/09 PROTECT_LOCALIZATION_FOLDER
		string strLocalization = _get_localization_folder();
		char szTemp[MAXFULLPATH];
		lstrcpy(szTemp, strLocalization);
		if(FindFile(GetFileName(lpcszFile), szTemp) == true) 
			return true;
		///End PROTECT_LOCALIZATION_FOLDER
	}

	return false;
}
///End SHOW_BUILT_IN_MEG_FOR_ALL_TEMPLATE_IN_EXE_FOLDER

///Jasmine 01/24/09 #4259 ADD_LOAD_SYSTEM_THEME_CHECK_BOX
static bool _is_load_system_theme(Page& page)
{	
	///Jasmine 02/06/09 CP_ASK_TURN_OFF_LOADSYS_CHECKBOX_IF_SAVE_BUILTIN_TEMPLATE
	string strCurrentFile = page_get_template_name(page);
	///Jasmine 02/17/09 SHOW_BUILT_IN_MEG_FOR_ALL_TEMPLATE_IN_EXE_FOLDER
	//if( is_built_in_template(page.GetType(), GetFileName(strCurrentFile, true), strCurrentFile) )
	///Jasmine 02/24/09 PROTECT_LOCALIZATION_FOLDER
	//if(lstrcmpi( GetFilePath(strCurrentFile), STR_SYSTEM_PATH) == 0)
	string strCurrentPath = GetFilePath(strCurrentFile);
	if(lstrcmpi(STR_SYSTEM_PATH, strCurrentPath) == 0 || strCurrentPath.Find( _get_localization_folder() )>= 0 )
		return false;
	///End SHOW_BUILT_IN_MEG_FOR_ALL_TEMPLATE_IN_EXE_FOLDER
	///End CP_ASK_TURN_OFF_LOADSYS_CHECKBOX_IF_SAVE_BUILTIN_TEMPLATE
	
	string strLT;
	strLT.Format("%s!page.cntrl", page.GetName());
	double dd;
	LT_get_var(strLT, &dd);
	DWORD dwCntrl = dd;
	return !(dwCntrl & PPDWCNTRL_IGNORE_SYSTEM_THEME);
}

static void _set_load_system_theme(Page& page, bool bLoad)
{
	string strLT;
	strLT.Format("%s!page.cntrl", page.GetName());
	double dd;
	LT_get_var(strLT, &dd);
	DWORD dwCntrl = dd;
	
	if(bLoad)
		dwCntrl &= ~PPDWCNTRL_IGNORE_SYSTEM_THEME;
	else
		dwCntrl |= PPDWCNTRL_IGNORE_SYSTEM_THEME;
	
	strLT.Format("page.cntrl = %d", dwCntrl);	
	page.LT_execute(strLT);
}
///End ADD_LOAD_SYSTEM_THEME_CHECK_BOX
	
