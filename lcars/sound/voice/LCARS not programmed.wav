//------ Folger 09/29/07 NEW_DISIGN_FOR_SAVING_TEMPLATE_XML
static void _remove_template_label_attribue(TreeNode &tr)
{
	foreach(TreeNode trBranch in tr.Children)
	{
		foreach(TreeNode trCategory in trBranch.Children)
		{
			octree_remove_attribute(&trCategory, STR_LABEL_ATTRIB);
		}
	}
}
//------ End NEW_DISIGN_FOR_SAVING_TEMPLATE_XML

static void _set_category_default_value(TreeNode& trGetN, int nType, string strCategory)
{
	///Jasmine 02/04/09 QA80-13028 SHOW_USER_DEFIND_CATEGORY_INSTEAD_OF_BUILT_IN_CATEGORY_WHEN_SAVING
	//if(!lstrlen(strCategory))
	if( !lstrlen(strCategory) || 0 == strCategory.CompareNoCase(STR_BUILT_IN_CATEGORY) )
	{		
		strCategory = "UserDefined";		
	}
	///End SHOW_USER_DEFIND_CATEGORY_INSTEAD_OF_BUILT_IN_CATEGORY_WHEN_SAVING
	
	if( !lstrlen(trGetN.category.strVal) || PDS_AUTO == okutil_cvt_str_to_predefined_type(trGetN.category.strVal) )
		trGetN.category.strVal = strCategory;
	
	vector<string> vsCategories;
	//------ Folger 10/10/07 FIX_BUGS_ABOUT_TEMPLATE_CATEGORY
	//okutil_get_template_categories(STR_TEMPLATE_XML, &vsCategories, nType);
	/// Iris 2/2/2015 ORG-12578-S1 NOT_ALLOW_SAVE_USER_TEMPLATE_INTO_BUILDIN_CATEGORY
	//if (okutil_get_template_categories(STR_TEMPLATE_XML, &vsCategories, nType) == 0)
		//okutil_get_template_categories(STR_SYSTEM_TEMPLATE_XML, &vsCategories, nType);
	okutil_get_template_categories(STR_TEMPLATE_XML, &vsCategories, nType);
	///End NOT_ALLOW_SAVE_USER_TEMPLATE_INTO_BUILDIN_CATEGORY
	//------ End FIX_BUGS_ABOUT_TEMPLATE_CATEGORY
	///Sophy 11/13/2015 ORG-13757-P8 PROPER_CHECK_UNTITLED_CATEGORY
	if ( trGetN.category.strVal.CompareNoCase(STR_UNTITLED_CATEGORY_LABEL) == 0 )
	{
		trGetN.category.strVal = "UserDefined";
	}
	int nIndex = vsCategories.Find(STR_UNTITLED_CATEGORY_LABEL);
	if ( nIndex >= 0 )
		vsCategories.RemoveAt(nIndex);
	///end PROPER_CHECK_UNTITLED_CATEGORY
	if(-1 == vsCategories.Find(strCategory))
		vsCategories.Add(strCategory);	
	if(-1 == vsCategories.Find("UserDefined"))
		vsCategories.Add("UserDefined");	
	string strList;
	strList.SetTokens(vsCategories, '|');	
	
	trGetN.category.SetAttribute(STR_COMBO_ATTRIB, "|" + strList);
	trGetN.category.SetAttribute(STR_OCNTRL_OPTNS, OCNTRLPARAM1_NOT_LOCALIZED);		//------ Folger 11/09/07 COMBO_TEXT_NO_NEEDED_LOCALIZE
}

///-----Kit 11/09/2010 ORG-1388-S1 SHOW_FILE_IN_TEMPLATE_CATEGORY
static bool _get_page( LPCTSTR lpcszPageName, Page &pg )
{
	string strPageName( lpcszPageName );
	strPageName.TrimLeft('[');
	strPageName.TrimRight(']');
	Page pgTemp( strPageName );
	
	if( !pgTemp.IsValid() )
		return false;
	
	pg = pgTemp;
	
	return true;
}

///-----Kit 11/25/2010 ORG-1388-P1 DROPDOWN_NAME_CAN_NOT_SHOW_FULLY
static bool	_check_need_resize_combo_box( const vector<string> &vsComboContent, int nSelFileNameLen )
{
	int nMaxComboContentLen = 0;
	for( int ii=0; ii<vsComboContent.GetSize(); ++ii )
	{
		if( nMaxComboContentLen < vsComboContent[ii].GetLength() )
			nMaxComboContentLen = vsComboContent[ii].GetLength();
	}
	
	return nSelFileNameLen > nMaxComboContentLen;
}

static bool _resize_combo_box( TreeNode &trResizeCtrl, int nNewLen )
{
	if( !trResizeCtrl.IsValid() )
		return false;
	
	string strWidth = "";
	strWidth.Format( "%d-%d", nNewLen, nNewLen );
	trResizeCtrl.SetAttribute( STR_ATTRIB_EDIT_DISPLAY_WIDTH_RANGE, strWidth );
	return true;
}
///-----End DROPDOWN_NAME_CAN_NOT_SHOW_FULLY

static bool _set_template_combobox_values( Tree &trGetN, const TreeNode &tnAllCategory, LPCTSTR lpcszSelTemplateFileName )
{
	/// Iris 2/2/2015 ORG-12578-S1 NOT_ALLOW_SAVE_USER_TEMPLATE_INTO_BUILDIN_CATEGORY
	//TreeNode tnCurrentSelectedCategory = tnAllCategory.FindNodeByAttribute( STR_LABEL_ATTRIB, trGetN.category.strVal );
	TreeNode tnCurrentSelectedCategory;
	if( tnAllCategory )
		tnCurrentSelectedCategory = tnAllCategory.FindNodeByAttribute( STR_LABEL_ATTRIB, trGetN.category.strVal );
	///End NOT_ALLOW_SAVE_USER_TEMPLATE_INTO_BUILDIN_CATEGORY

	string strList = "";
	if( tnCurrentSelectedCategory.IsValid() )	
	{
		vector<string> vsTemplateNamesExt;
		tree_get_attributes( tnCurrentSelectedCategory, vsTemplateNamesExt, STR_NAME_ATTRIB );
		
		///------ Tony 08/26/2015 ORG-13203-P4 USE_FILENAME_IF_NO_NAME_ATTRIBUTE
		vector<string> vsFileNamesExt;
		tree_get_attributes( tnCurrentSelectedCategory, vsFileNamesExt, STR_FILENAME_ATTRIB );
		///------ End USE_FILENAME_IF_NO_NAME_ATTRIBUTE

		string strCategory = trGetN.category.strVal;		
		bool bUserDefinedName = ( strCategory.CompareNoCase( "UserDefined" ) == 0 );		
		vector<string> vsTemplateNames;
		
		for( int ii=0; ii<vsTemplateNamesExt.GetSize(); ii++ )
		{
			string strFileName = GetFileName( vsTemplateNamesExt[ii], true );
			///------ Tony 08/26/2015 ORG-13203-P4 USE_FILENAME_IF_NO_NAME_ATTRIBUTE
			if(strFileName.IsEmpty())
			{
				strFileName = GetFileName( vsFileNamesExt[ii], true );
				if(strFileName.IsEmpty())
					continue;
			}
			///------ End USE_FILENAME_IF_NO_NAME_ATTRIBUTE
			if( bUserDefinedName )
			{
				if( -1 == vsTemplateNames.Find( strFileName ) )
					vsTemplateNames.Add( strFileName );
			}
			else
				vsTemplateNames.Add( strFileName );
		}
	
		strList.SetTokens( vsTemplateNames, '|' ); 
		  
		///-----Kit 11/25/2010 ORG-1388-P1 DROPDOWN_NAME_CAN_NOT_SHOW_FULLY	
		#define	DROPDOWN_BUTTON_NEED_MORE_GAP	2
		if( _check_need_resize_combo_box( vsTemplateNames, lstrlen( lpcszSelTemplateFileName ) ) )
		{
			_resize_combo_box( trGetN.template, lstrlen( lpcszSelTemplateFileName ) + DROPDOWN_BUTTON_NEED_MORE_GAP ); 
		}
		///-----End DROPDOWN_NAME_CAN_NOT_SHOW_FULLY
	}
	
	trGetN.template.SetAttribute( STR_COMBO_ATTRIB, "|" + strList );
	///------ Folger 06/24/2015 ORG-13209-S2 TEMPLATE_SAVEAS_INITIAL_FOCUS_ON_TEMPLATE_EDIT
	//trGetN.template.SetAttribute( STR_OCNTRL_OPTNS, OCNTRLPARAM1_NOT_LOCALIZED);
	trGetN.template.SetAttribute( STR_OCNTRL_OPTNS, OCNTRLPARAM1_NOT_LOCALIZED | OCNTRLPARAM1_DEFAULT_FOCUS );
	///------ End TEMPLATE_SAVEAS_INITIAL_FOCUS_ON_TEMPLATE_EDIT
	
	return true;
}
///-----End SHOW_FILE_IN_TEMPLATE_CATEGORY

///------ Tony 08/11/2015 ORG-13209-P1 SHORT_LONG_NAME_COMBO_LOAD
#define DLG_NAME	"template_saveas"
#define SHORT_NAME_LIST "ShortName List"
#define LONG_NAME_LIST "LongName List"
#define MAX_LIST_SIZE 20
static void _save_name_combo_list(TreeNode& trName, const string& strListName)
{
	string strCombo;
	trName.GetAttribute(STR_COMBO_ATTRIB, strCombo);
	if( !trName.strVal.IsEmpty() && strCombo.FindToken( trName.strVal, '|' ) < 0 )
	{
		vector<string> vsComboTokens;
		//>>..User
		//:
		//<auto>
		int nAutoOffset = 3;
		if(strCombo.GetTokens( vsComboTokens, '|') && vsComboTokens.GetSize() >= MAX_LIST_SIZE + nAutoOffset)
		{
			vsComboTokens.RemoveAt(nAutoOffset);
			strCombo.SetTokens(vsComboTokens, '|');
		}
			
		strCombo = strCombo + "|" + trName.strVal;		
	}
	dlg_save_to_registry(DLG_NAME, strListName, strCombo);		
}

static void _load_name_combo_list(TreeNode& trName, const string& strListName)
{
	string strCombo;
	if(dlg_load_registry(DLG_NAME, strListName, strCombo))
	{
		trName.SetAttribute(STR_COMBO_ATTRIB, strCombo);
	}
	else
	{
		string str = ">>.."+ "User" + "|:|" + STR_AUTO;
		trName.SetAttribute(STR_COMBO_ATTRIB, str);
	}
}
///------ End SHORT_LONG_NAME_COMBO_LOAD

///-----Kit 11/15/2010 ORG-1483-P3 NO_NEED_POPUP_CONFIRM_MSG_WHEN_TEMPLATE_HAVE_IN_USER_FOLDER
static bool _is_in_system_folder_not_in_user_folder( LPCTSTR lpcszFullFileName )
{	
	string strFullFileName = lpcszFullFileName;
	ASSERT( !strFullFileName.IsPath() );
	string strSystemFile = STR_SYSTEM_PATH + GetFileName( lpcszFullFileName );

	if( strSystemFile.IsFile() && !strFullFileName.IsFile() )
		return true;
	
	return false;
}
///-----End NO_NEED_POPUP_CONFIRM_MSG_WHEN_TEMPLATE_HAVE_IN_USER_FOLDER

//------ Folger 08/24/07 USE_TEMPLATE_ORGANIZER_TO_ACCESS_TEMPLATE_XML
bool _is_path_allow_saving(string strPath)
{
	vector<string> vsPaths;
	vsPaths.Add(okutil_get_origin_path(ORIGIN_PATH_SYSTEM, NULL, TRUE));
	vsPaths.Add(okutil_get_origin_path(ORIGIN_PATH_GROUP, NULL, TRUE));
	for (int ii=0; ii<vsPaths.GetSize(); ii++)
	{
		if (strPath.CompareNoCase(vsPaths[ii]) == 0)
			return false;
	}
	//------ Folger 09/29/07 NOT_ALLOW_SAVE_IN_LOCALIZATION_FOLDER
	///Jasmine 02/24/09 PROTECT_LOCALIZATION_FOLDER
	////hard code, need to clean up later
	//string strLocalization = okutil_get_language_path(true);
	//strLocalization.Delete(strLocalization.GetLength() - 2, 2);
	//strLocalization.Insert(0, GetAppPath(true));
	//strLocalization.MakeUpper();
	string strLocalization = _get_localization_folder();
	///End PROTECT_LOCALIZATION_FOLDER
	///------ Tony 06/12/2012 ORG-5622-P1 DEFAULT_PATH_OF_SAVING_TEMPLATE_INCORRECT
	///if (strPath.Find(strLocalization) == 0)
	if (strPath.Find(strLocalization, 0, FALSE) == 0)
	///------ End DEFAULT_PATH_OF_SAVING_TEMPLATE_INCORRECT	
	return false;
	//------ End NOT_ALLOW_SAVE_IN_LOCALIZATION_FOLDER
	
	return true;
}
