///------ Tony 10/20/2015 ORG-13209-S7 TEMPLATE_SAVEAS_LT_IMPROVE
static int _get_modifier_type(Page& pg, string& strLabel)
{
	GraphPage gp = pg;
	if(!gp || strLabel.IsEmpty())
		return PMMT_OFFSET;
	
	int nRCLTType = RCLT_INVALID;
	vector<string> vsUDLs;
	gp.GetCommonUPL(&vsUDLs);
	int nOffset = vsUDLs.Find(strLabel);
	if ( nOffset >= 0 )
	{
		nRCLTType = RCLT_UDL + nOffset;
	}
	else
	{
		Worksheet wks;
		nRCLTType = get_label_type_by_name_or_indentifier(wks, strLabel);
	}
	
	int nType = PMMT_OFFSET;
	switch(nRCLTType)
	{
	case RCLT_SHORT_NAME:
		nType = PMMT_SNAME;
		break;
	
	case RCLT_LONG_NAME:
		nType = PMMT_LNAME;
		break;
		
	case RCLT_UNIT:
		nType = PMMT_UNIT;
		break;
		
	case RCLT_COMMENT:
		nType = PMMT_COMMENT;
		break;
		
	default:
		if(nRCLTType >= RCLT_PARAM && nRCLTType < RCLT_SAMPLE_RATE)
		{
			nType = nRCLTType - RCLT_PARAM + PMMT_PARAM;
		}
		else if(nRCLTType >= RCLT_UDL && nRCLTType <= RCLT_MAX_UDL)
		{
			nType = nRCLTType - RCLT_UDL + PMMT_USERPARAM;
		}
	
	}
	
	return nType;
}


///------ End TEMPLATE_SAVEAS_LT_IMPROVE

//------ End USE_TEMPLATE_ORGANIZER_TO_ACCESS_TEMPLATE_XML
static bool _init_dlg(TreeNode& trGetN)
{
	if(!trGetN.IsValid())
		return false;	
	//////page//////
	///-----Kit 11/09/2010 ORG-1388-S1 SHOW_FILE_IN_TEMPLATE_CATEGORY
	//string strPage = trGetN.pg.strVal;
	//strPage.TrimLeft('[');
	//strPage.TrimRight(']');
	//Page pg(strPage);
	//if(!pg.IsValid())
		//return error_report("Error! Page is invalid!");
	Page pg;
	if( !_get_page( trGetN.pg.strVal, pg ) )
		return error_report("Error! Page is invalid!");
	///-----End SHOW_FILE_IN_TEMPLATE_CATEGORY
	
	//---- CPY 8/17/06 QA70-8428 ADD_SAVE_AS_OPTION
	trGetN.pg.Enable = ENABLE_READ_ONLY;
	//----
	
	//---- Jake 04/06/07 ADD_SAVE_TEMPLATE_AS_OPTION
	trGetN.savetemplate.Enable = ENABLE_READ_ONLY;
	//---- end ADD_SAVE_TEMPLATE_AS_OPTION
	
	int nType = pg.GetType();
	/// Kenny 3/14/2017 ORG-14896-S1 ORIGIN_SUPPORT_SHELL_THUMBNAIL_AND_PREVIEW
	//string strExt = page_get_template_ext(nType);
	string strExt = page_get_template_ext(nType, NULL, TEMPL_EXT_FLAG_NEW_TYPE);
	/// End ORIGIN_SUPPORT_SHELL_THUMBNAIL_AND_PREVIEW
	string	strFileDlgAllExts = page_get_template_FileDlg_exts(nType);	/// ML 06/02/2017 ORG-15165-P1 template_saveas_USE_NEW_TEMPLATE_EXTENSIONS

	////////Template Name////////
	string strTemplate = trGetN.template.strVal, strFileCurrent;
	if(!lstrlen(strTemplate) || PDS_AUTO == okutil_cvt_str_to_predefined_type(strTemplate))	///Jasmine 06/05/07 TEMPLATE_CHANGE_UNASSIGNED_TO_AUTO
	{
		strFileCurrent = page_get_template_name(pg);
		///------ Tony 08/07/2015 ORG-13209-S5 NOT_ALLOW_SAME_TEMPLATE_NAME
		////------ Folger 08/01/07 TEMPLATE_CAN_ONLY_SAVED_IN_ONE_CATEGORY
		////strTemplate = GetFileName(strFileCurrent, true);
		////trGetN.template.strVal = strTemplate;
		//strTemplate = okutil_composite_name_from_file_path(strFileCurrent, "Templates");	//find the proper template name
		//trGetN.template.strVal = GetFileName(strFileCurrent, true);		//name show in dialog is without "(User)" when user-defined
		////------ End TEMPLATE_CAN_ONLY_SAVED_IN_ONE_CATEGORY
		strTemplate = GetFileName(strFileCurrent, true);
		trGetN.template.strVal = strTemplate;
		///------ End NOT_ALLOW_SAME_TEMPLATE_NAME
	}
	
	///Jasmine 03/30/09 SHOW_DESCRIPTION_STORED_IN_TEMPLATE
	string strDesc = trGetN.desc.strVal;	
	if( !lstrlen(strDesc) || PDS_AUTO == okutil_cvt_str_to_predefined_type(strDesc) )
	{
		strDesc.Empty();
		okutil_get_Origin_file_comment(strFileCurrent, &strDesc);
		trGetN.desc.strVal = strDesc;	
	}
	///End SHOW_DESCRIPTION_STORED_IN_TEMPLATE
	
	////////Category////////
	//------ Folger 08/24/07 USE_TEMPLATE_ORGANIZER_TO_ACCESS_TEMPLATE_XML
	//Tree trXML;
	//load_template_tree(trXML);//trXML.Load(STR_TEMPLATE_XML);
	//TreeNode trBranch = tree_get_node_by_id(trXML, nType);
	//string strFile, strCate;
	//_find_template(trBranch, strTemplateSuffix, strFile, strCate);
	
	TemplateOrganizer to;
	Tree trXML;
	/// Iris 2/2/2015 ORG-12578-S1 NOT_ALLOW_SAVE_USER_TEMPLATE_INTO_BUILDIN_CATEGORY
	//to.GetTemplateListFile(trXML);
	to.GetTemplateListFile(trXML, true);
	///End NOT_ALLOW_SAVE_USER_TEMPLATE_INTO_BUILDIN_CATEGORY
	TreeNode trBranch = tree_get_node_by_id(trXML, nType);
	TreeNode trTemplate, trCategory;	
	to.FindTemplate(trBranch, strTemplate, trTemplate, trCategory);
	string strFile, strCate;
	if (trTemplate)
		trTemplate.GetAttribute(STR_FILENAME_ATTRIB, strFile);
	if (trCategory)
		trCategory.GetAttribute(STR_LABEL_ATTRIB, strCate);
	//------ End USE_TEMPLATE_ORGANIZER_TO_ACCESS_TEMPLATE_XML
	
	_set_category_default_value(trGetN, nType, strCate);
	
	_set_template_combobox_values( trGetN, trBranch, trGetN.template.strVal ); ///-----Kit 11/09/2010 ORG-1388-S1 SHOW_FILE_IN_TEMPLATE_CATEGORY
	//---- Jake 04/06/07 ADD_SAVE_TEMPLATE_AS_OPTION
	string strTemplateType;
	if(trBranch)
		trBranch.GetAttribute(STR_LABEL_ATTRIB, strTemplateType);
	//---Jasmine 02/04/09 EXTENSION_IS_ADDED_IN_BRANCH_LABEL, brach label used to be "Graph" and now it's "Graph Template (*.otp)"
	//trGetN.savetemplate.strVal=strTemplateType+" Template [*"+strExt+"]";
	trGetN.savetemplate.strVal = strTemplateType;
	//---end
	//---- end ADD_SAVE_TEMPLATE_AS_OPTION
	
	///Jasmine 01/24/09 #4259 ADD_LOAD_SYSTEM_THEME_CHECK_BOX
	if( EXIST_PLOT == nType )
	{
		trGetN.loadsys.Show = true;
	
		if( PDS_AUTO == okutil_cvt_str_to_predefined_type(trGetN.loadsys.strVal) )
			trGetN.loadsys.nVal = _is_load_system_theme(pg);
		
		///------ Tony 09/10/2015 ORG-13209-S7 SHOW_MATCH_MODIFIER_TO_SAVE_TEMPLATE
		if(trGetN.matchModifiers)
		{
			trGetN.matchModifiers.Show = true;
			
			vector<string> vsMatchByCombo;
			vsMatchByCombo.RemoveAll();
			vsMatchByCombo.Add(GetLocalized(E_STR_NUMERIC_OFFSET));
			vsMatchByCombo.Add(GetLocalized(STR_LABEL_SHORT_NAME_E));
			vsMatchByCombo.Add(GetLocalized(E_STR_LONGNAME));
			vsMatchByCombo.Add(GetLocalized(E_STR_UNITS));
			vsMatchByCombo.Add(GetLocalized(E_STR_COMMENTS));
			vsMatchByCombo.Add(GetLocalized(E_STR_PARAMETERS));
			for (int idx = 1; idx < PARAMS_MAX_NUM; ++idx)
			{
				string		strName;
				strName.Format(("%s %d"), GetLocalized(E_STR_PARAMETERS), idx + 1);
				vsMatchByCombo.Add(strName);
			}

			GraphPage gp = pg;
			vector<string> vsUDLs;
			gp.GetCommonUPL(&vsUDLs);
			int nType = PMMT_OFFSET;
			Tree trFmt;
			trFmt = gp.GetFormat(FPB_OTHER, FOB_OTHER, true, true);
			if(trFmt.Root.Misc.MatchBy)
				nType = trFmt.Root.Misc.MatchBy.nVal;
			if ( nType >= PMMT_USERPARAM && nType < PMMT_USERPARAM_END)
			{
				string	strName;
				if(trFmt.Root.Misc.MatchUDL)
					strName = trFmt.Root.Misc.MatchUDL.strVal;
				
				//strName is not empty normally
				if(strName.IsEmpty())
					nType = PMMT_OFFSET;
				else 
				{
					int nFound = vsUDLs.Find(strName); 
					if (-1 == nFound)
					{
						vsUDLs.InsertAt(0, strName);
						nType = PMMT_USERPARAM;
					}
					else
					{
						nType = PMMT_USERPARAM + nFound;
						ASSERT(nType < PMMT_USERPARAM_END);
					}
					
				}
			}
			for (idx = 0; idx < vsUDLs.GetSize(); ++idx)
				vsMatchByCombo.Add(vsUDLs[idx]);
		
			string strCombo;
			strCombo.SetTokens(vsMatchByCombo, '|');
			//trGetN.matchModifiers.SetAttribute(STR_ID_ATTRIB, ONODETYPE_DROPLIST_STRINGS);	///------ Tony 10/10/2015 ORG-13209-S7 MATCH_MODIFIER_USE_STRING
			///------ End MATCH_MODIFIER_USE_STRING
			trGetN.matchModifiers.SetAttribute(STR_COMBO_ATTRIB, strCombo);
			///------ Tony 10/10/2015 ORG-13209-S7 MATCH_MODIFIER_USE_STRING
			//trGetN.matchModifiers.nVal = nType;
			if(trGetN.matchModifiers.strVal.IsEmpty())
				trGetN.matchModifiers.strVal = vsMatchByCombo[nType];
			///------ End MATCH_MODIFIER_USE_STRING
		}
		///------ End SHOW_MATCH_MODIFIER_TO_SAVE_TEMPLATE
	}
	else 
	{
		trGetN.loadsys.Show = false;
		trGetN.matchModifiers.Show = false;	///------ Tony 09/10/2015 ORG-13209-S7 SHOW_MATCH_MODIFIER_TO_SAVE_TEMPLATE
	}
	
	///Jasmine 02/03/09 #4259 ADD_HINT_FOR_LOAD_SYSTEM_THEME_CHECK_BOX
	trGetN.hint.SetAttribute(STR_ATTRIB_DISPFMT, DISPLAY_EDITOR_USE_LABEL | DISPLAY_EDITOR_NEXT_LINE | DISPLAY_EDITOR_WRAPPED);
	trGetN.hint.Show = false;
	if(trGetN.loadsys.Show != false && trGetN.loadsys.nVal == true)
	{
		trGetN.hint.Show = true;
	}
	///End ADD_HINT_FOR_LOAD_SYSTEM_THEME_CHECK_BOX
	///End ADD_LOAD_SYSTEM_THEME_CHECK_BOX
	
	///Jasmine 02/09/09 REMOVE_OPTION_BRANCH
	/*
	////////Option///////////
	if(trGetN.option)
	{
		//----- CPY 11/4/07 LOCALIZATION_NEEDED
		// I have put in _L in all needed places withouth separate comments
		//-----
		///Set Default///
		//GETN_CHECK(setdefault,"Set Default", false) ///Jasmine 10/17/06, wait SetDefaultTemplate
	}	
	*/	
	if( !lstrlen(trGetN.filepath.strVal) || PDS_AUTO == okutil_cvt_str_to_predefined_type(trGetN.filepath.strVal) )
	{
		if(lstrlen(strFileCurrent))
			strFile = strFileCurrent;
		
		trGetN.filepath.strVal = lstrlen(strFile) && _is_path_allow_saving(GetFilePath(strFile))? GetFilePath(strFile) : STR_USER_PATH;///set user folder as default
	}
	
	string strSave;
	/// ML 06/02/2017 ORG-15165-P1 template_saveas_USE_NEW_TEMPLATE_EXTENSIONS
	//strSave.Format("...Save:[%s] *%s",strTemplateType, strExt);
	//strSave.Format("...Save:[%s] %s",strTemplateType, strFileDlgAllExts);
	strSave.Format("...Save:%s", strFileDlgAllExts);
	/// end template_saveas_USE_NEW_TEMPLATE_EXTENSIONS
   	trGetN.filepath.SetAttribute(STR_COMBO_ATTRIB, strSave);
   	trGetN.filepath.SetAttribute(STR_FILENAME_ATTRIB, trGetN.filepath.strVal + trGetN.template.strVal + strExt);
   	trGetN.filepath.SetAttribute(STR_DLG_OPTIONS_ATTRIB, FDLG_SUPPRESS_WARNING_SAVE_TO_EXISTING|FDLG_FILENAME_BOX_READ_ONLY);
   	tree_set_browse_combo_attrib(trGetN.filepath, NULL, false);	///Jasmine 07/04/07 ADD_PATH_TRACK
	
   	 
   	trGetN.emf.Show = nType == EXIST_PLOT;
   	trGetN.bmp.Show = nType == EXIST_PLOT;
   	///End REMOVE_OPTION_BRANCH
   	
	//------ Folger 08/24/07 USE_TEMPLATE_ORGANIZER_TO_ACCESS_TEMPLATE_XML
	//return true;
	return _is_path_allow_saving(GetFilePath(strFileCurrent));
	//------ End USE_TEMPLATE_ORGANIZER_TO_ACCESS_TEMPLATE_XML
}
///Sophy 11/12/2015 ORG-13757-P7 PROPER_CHECK_TEMPLATES_CHANGE_AND_REFRESH
typedef	void(*PFN_NotifyTemplateLibraryOnSaveTemplate)(string strFilePath);
///end PROPER_CHECK_TEMPLATES_CHANGE_AND_REFRESH
 

void template_saveas(const Page& pg, const string& category, const string& template, const string& desc, const string& savetemplate, const string& sname, const string& lname, const TreeNode& clone, const string& matchModifiers, const string& filepath, const int& emf, const int& bmp, const int& loadsys, const string& hint, const int& asksave, const string& templateEdit)
{
	 	
	//------ Folger 03/11/08 QA80-11175 SAVE_LAYOUT_TEMPLATE
	if ( pg.GetType() == EXIST_LAYOUT )
	{
		/// Kenny 3/14/2017 ORG-14896-S1 ORIGIN_SUPPORT_SHELL_THUMBNAIL_AND_PREVIEW
		//string strFile = page_get_template_name(pg) + ".otp";
		string strFile = page_get_template_name(pg) + page_get_template_ext(EXIST_PLOT, NULL, TEMPL_EXT_FLAG_NEW_TYPE);
		/// End ORIGIN_SUPPORT_SHELL_THUMBNAIL_AND_PREVIEW
		string strName = pg.GetName();
		string strMsg;
		ocu_load_msg_str(XFWARN_SAVE_AS, &strMsg, strName, NULL, strFile);
		if ( IDYES == MessageBox(GetWindow(), strMsg, _L("Attention!"), MB_YESNO | MB_DEFBUTTON2 | MB_ICONEXCLAMATION) )
		{
			LT_execute("save -Tb 200 %H %A;");
		}
		return;
	}
	//------
	
	//////get page and its type//////
	if( !pg.IsValid() || !lstrlen(template) )//invalid page or no template name!
		XF_THROW(CER_INVALID_ARGUMENT);
	int nType = pg.GetType();
	/// Kenny 3/14/2017 ORG-14896-S1 ORIGIN_SUPPORT_SHELL_THUMBNAIL_AND_PREVIEW
	//string strExt = page_get_template_ext(nType);
	string strExt = page_get_template_ext(nType, NULL, TEMPL_EXT_FLAG_NEW_TYPE);
	/// End ORIGIN_SUPPORT_SHELL_THUMBNAIL_AND_PREVIEW
	//////check path//////
	string strPath = filepath;
	if(PDS_AUTO == okutil_cvt_str_to_predefined_type(strPath) || !lstrlen(strPath))// strParam is <auto> or nothing
		strPath = STR_USER_PATH;
	if(!strPath.IsPath())
		XF_THROW(CER_INVALID_FILEPATH);
	if(strPath.Right(1).CompareNoCase(OFSEPS))
		strPath += OFSEPS;
	//////check template name//////
	///------ Tony 11/04/2015 ORG-13734-S1 TEMPLATE_NAME_SUPPORT_DOT
	//string strTemplate = GetFileName(template, true);
	string strTemplate = template;
	///------ End TEMPLATE_NAME_SUPPORT_DOT
	///Jasmine 06/05/07 TEMPLATE_CHANGE_UNASSIGNED_TO_AUTO
	if(!lstrlen(template) || PDS_AUTO == okutil_cvt_str_to_predefined_type(template))
	{
		string strFileCurrent = page_get_template_name(pg);
		strTemplate = GetFileName(strFileCurrent, true);
	}
	///End TEMPLATE_CHANGE_UNASSIGNED_TO_AUTO
	/// ML 06/02/2017 ORG-15165-P1 template_saveas_USE_NEW_TEMPLATE_EXTENSIONS
	//string strFullPathFile = strPath + strTemplate + strExt;
	string strFullPathFile;
	if ( !s_strPathNameForSaving.IsEmpty() )
	{
		strFullPathFile = s_strPathNameForSaving;
		s_strPathNameForSaving.Empty();
	}
	else
		strFullPathFile = strPath + strTemplate + strExt;
	/// end template_saveas_USE_NEW_TEMPLATE_EXTENSIONS
	string strTemplateSuffix = okutil_composite_name_from_file_path(strFullPathFile, "Templates");	//------ Folger 08/01/07 TEMPLATE_CAN_ONLY_SAVED_IN_ONE_CATEGORY
	
	//------ Folger 08/24/07 USE_TEMPLATE_ORGANIZER_TO_ACCESS_TEMPLATE_XML
	//Tree trXML;
	//load_template_tree(trXML);//trXML.Load(STR_TEMPLATE_XML);
	//TreeNode trBranch = tree_get_node_by_id(trXML, nType);
	//string strFile, strCate;
	//_find_template(trBranch, strTemplateSuffix, strFile, strCate);//check if template name exist in template organizer
	
	TemplateOrganizer to;
	Tree trXML;
	/// Iris 2/2/2015 ORG-12578-S1 NOT_ALLOW_SAVE_USER_TEMPLATE_INTO_BUILDIN_CATEGORY
	//to.GetTemplateListFile(trXML);
	to.GetTemplateListFile(trXML, true);
	///End NOT_ALLOW_SAVE_USER_TEMPLATE_INTO_BUILDIN_CATEGORY
	TreeNode trBranch = tree_get_node_by_id(trXML, nType);
	//------ Folger 10/10/07 CORRECT_BEHAVIOR_OF_FINDING_CATEGORY_AND_TEMPLATE
	//TreeNode trTemplate, trCategory;	
	//to.FindTemplate(trBranch, strTemplateSuffix, trTemplate, trCategory);
	//string strCate;
	//if (trCategory)
		//trCategory.GetAttribute(STR_LABEL_ATTRIB, strCate);
		//
	//if (category.CompareNoCase(strCate))
		//trCategory = to.NewCategory(trBranch, category);
	
	TreeNode trCategory;
	/// Iris 2/2/2015 ORG-12578-S1 NOT_ALLOW_SAVE_USER_TEMPLATE_INTO_BUILDIN_CATEGORY
	//if (!to.FindCategory(trBranch, category, trCategory))
	if (trBranch && !to.FindCategory(trBranch, category, trCategory))
	///End NOT_ALLOW_SAVE_USER_TEMPLATE_INTO_BUILDIN_CATEGORY
		trCategory = to.NewCategory(trBranch, category);
	//------ End CORRECT_BEHAVIOR_OF_FINDING_CATEGORY_AND_TEMPLATE
	
	//------ End USE_TEMPLATE_ORGANIZER_TO_ACCESS_TEMPLATE_XML
	///Jasmine 07/04/07 ALLOW_SAVE_TO_DIFFERENT_PATH_AND_UPDATE_ATTRIBUTE_IN_ORGANIZER
	/*
	bool bBuiltIn = is_built_in_template(nType, strTemplate, strFile);
	while(!bBuiltIn && lstrlen(strFile) && strFullPathFile.CompareNoCase(strFile))//the same name, the same path
	{
		///Cheney 2007-5-30 UPDATE_XF_ERR_THROW
		//string strWarning = "Template name is used by "+ strFile +"\nPlease select another name.";
		string strWarning;
		ocu_load_msg_str(XFWARN_TEMPLATE_NAME_IS_USED, &strWarning, strFile);
		///end UPDATE_XF_ERR_THROW
		GETN_TREE(trRename)
			GETN_STR(Name, "Template Name", strTemplate)
		if(!GetNBox(trRename, "Rename", strWarning, NULL, NULL, NULL))
			return;//XF_THROW(XFERR_INVALID_OPERATION);//crash
		strTemplate = GetFileName(trRename.Name.strVal, true);
		strFile.Empty();
		strCate.Empty();
		_find_template(trBranch, strTemplate, strFile, strCate);
	}
	*/
	///End ALLOW_SAVE_TO_DIFFERENT_PATH_AND_UPDATE_ATTRIBUTE_IN_ORGANIZER
	//////check file//////
	//strFullPathFile = strPath + strTemplate + strExt;		//------ Folger 08/01/07 TEMPLATE_CAN_ONLY_SAVED_IN_ONE_CATEGORY
	
	
	///------ Tony 08/07/2015 ORG-13209-S5 NOT_ALLOW_SAME_TEMPLATE_NAME
	bool bReplaceSameNameTemplate = !s_bSameNameTempNeedCheck;
	if(s_bSameNameTempNeedCheck)
	{
		if(to.IsNeedCheckReplaceSameNameTemplate(trBranch, strFullPathFile, category))
		{
			string strWarning;
			ocu_load_msg_str(IDS_TEMPLATE_SAME_NAME_IN_LIBRARY, &strWarning);
			if(IDCANCEL == MessageBox(GetWindow(), strWarning, _L("Save As"), MB_OKCANCEL|MB_ICONEXCLAMATION))
			{
				XF_THROW(XFERR_INVALID_OPERATION);
			}
			
			bReplaceSameNameTemplate = true;
		}
	}
	s_bSameNameTempNeedCheck = true;
	///------ End NOT_ALLOW_SAME_TEMPLATE_NAME
	
	//------ Folger 08/24/07 USE_TEMPLATE_ORGANIZER_TO_ACCESS_TEMPLATE_XML
	
	//if (s_nGetNDialog == 1)
	//------ Folger 02/27/08 QA80-11175 AUTO_SAVE_SYSTEM_GROUP_TEMPLATE_INTO_UFF
	//if ( asksave )
	///Jasmine 02/09/09 REMOVE_OPTION_BRANCH
	//if ( asksave || option.filepath.strVal.CompareNoCase(GetFilePath(page_get_template_name(pg))) )
	///Jasmine 02/10/09 CHANCE_TO_MAKE_CHANGE_IF_FILE_EXIST
	///------ Tony 08/06/2015 ORG-13290-P2 SAVE_TEMPLATE_EDIT_MODE_IMPROVE
	//if(s_bAskIfExist)
	bool bEditAndSameName = 0 == template.CompareNoCase(templateEdit);
	if(s_bAskIfExist && !bEditAndSameName)
	///------ End SAVE_TEMPLATE_EDIT_MODE_IMPROVE
	{
		if ( asksave || filepath.CompareNoCase(GetFilePath(page_get_template_name(pg))) )
		///End REMOVE_OPTION_BRANCH
		//------
		{
			if(strFullPathFile.IsFile())
			{
				///Cheney 2007-5-30 UPDATE_XF_ERR_THROW
				//string strWarning = strFullPathFile + " already exists!\nDo you want to replace it?";
				string strWarning;
				ocu_load_msg_str(XFWARN_TEMPLATE_ALREADY_EXISTS, &strWarning, strFullPathFile);
				///end UPDATE_XF_ERR_THROW
				if(IDNO == MessageBox(NULL, strWarning, _L("Save As"), MB_YESNO|MB_ICONEXCLAMATION))
					XF_THROW(XFERR_INVALID_OPERATION);
			}
		}
		//------ End USE_TEMPLATE_ORGANIZER_TO_ACCESS_TEMPLATE_XML
	}
	///End CHANCE_TO_MAKE_CHANGE_IF_FILE_EXIST
	
	//////update template.xml//////
	///Jasmine 07/04/07 ALLOW_SAVE_TO_DIFFERENT_PATH_AND_UPDATE_ATTRIBUTE_IN_ORGANIZER
	//if(bBuiltIn)//need update file name
	//{	
	
	//------ Folger 08/24/07 USE_TEMPLATE_ORGANIZER_TO_ACCESS_TEMPLATE_XML
	//bool bReplace = lstrlen(category) && strCate.CompareNoCase(category);	//------ Folger 08/01/07 TEMPLATE_CAN_ONLY_SAVED_IN_ONE_CATEGORY
		//foreach(TreeNode trCate in trBranch.Children)
		//{
			//TreeNode trTemp = trCate.FindNodeByAttribute(STR_LABEL_ATTRIB, strTemplateSuffix);
			//if(trTemp.IsValid())
			//{
				////------ Folger 08/01/07 TEMPLATE_CAN_ONLY_SAVED_IN_ONE_CATEGORY
				////trTemp.SetAttribute(STR_FILENAME_ATTRIB, strFullPathFile);
				//if (bReplace)
				//{
					//string strWarning;
					//strWarning.Format("%s is in Category %s.\nDo you want to move it to Category %s ?",
										//strTemplateSuffix, strCate, category);
					//if(IDYES == MessageBox(NULL, strWarning, "Save As", MB_YESNO|MB_ICONEXCLAMATION))
					//{
						//trTemp.Remove();
					//}
					//else
						//bReplace = false;
				//}
				////------ End TEMPLATE_CAN_ONLY_SAVED_IN_ONE_CATEGORY
			//}
		//}
		//trXML.Save(STR_TEMPLATE_XML);
		//------ End USE_TEMPLATE_ORGANIZER_TO_ACCESS_TEMPLATE_XML
		
	//}
	///End ALLOW_SAVE_TO_DIFFERENT_PATH_AND_UPDATE_ATTRIBUTE_IN_ORGANIZER
	//------ Folger 08/01/07 TEMPLATE_CAN_ONLY_SAVED_IN_ONE_CATEGORY
	//if(lstrlen(category) && category.CompareNoCase(strCate))//a template can add to more than one categories	
	
	//------ Folger 08/24/07 USE_TEMPLATE_ORGANIZER_TO_ACCESS_TEMPLATE_XML
	//if (bReplace)
	////------ End TEMPLATE_CAN_ONLY_SAVED_IN_ONE_CATEGORY
	//{
		//int nRet = okutil_add_template(STR_TEMPLATE_XML, category, strFullPathFile, nType);//nRet = 0 if success else nRet = 1
		////FileCopy(STR_TEMPLATE_XML, STR_GROUP_TEMPLATE_XML);	///Jasmine 08/15/07 QA80-10155 NO_MODIFICATION_TO_GROUP_FOLDER_FILE
	//}
	//------ End USE_TEMPLATE_ORGANIZER_TO_ACCESS_TEMPLATE_XML
	
	///Jasmine 01/24/09 #4259 ADD_LOAD_SYSTEM_THEME_CHECK_BOX
	if( EXIST_PLOT == pg.GetType() )
		_set_load_system_theme(pg, loadsys);
	///End ADD_LOAD_SYSTEM_THEME_CHECK_BOX
	
	//////save template//////
	//string desc = option.desc? option.desc.strVal : "";	///Jasmine 02/09/09 REMOVE_OPTION_BRANCH
	
	///-----Kit 11/11/2010 ORG-1483-P1 POPUP_MSG_WITH_MSGBOX_WHEN_THE_TEMPLATE_IS_SAME_AS_BULITIN
	///-----Kit 11/15/2010 ORG-1483-P3 NO_NEED_POPUP_CONFIRM_MSG_WHEN_TEMPLATE_HAVE_IN_USER_FOLDER
	//if( asksave == 0 && _override_exe_folder( strFullPathFile ) )
	///------ Tony 08/06/2015 ORG-13290-P2 SAVE_TEMPLATE_EDIT_MODE_IMPROVE
	//if( asksave == 0 && _is_in_system_folder_not_in_user_folder( strFullPathFile ) )
	if( !bEditAndSameName && asksave == 0 && _is_in_system_folder_not_in_user_folder( strFullPathFile ) )
	///------ End SAVE_TEMPLATE_EDIT_MODE_IMPROVE
	///-----
	{		
		string strMessage;
		ocu_load_err_msg_str( CER_BUILT_IN_TEMPLATE_NAME, &strMessage );
		if( IDCANCEL == MessageBox( GetWindow(), strMessage, _L("Save As"), MB_OKCANCEL|MB_ICONEXCLAMATION ) )
			return;
	}
	///-----End POPUP_MSG_WITH_MSGBOX_WHEN_THE_TEMPLATE_IS_SAME_AS_BULITIN
	
	/// Iris 6/24/2015 ORG-13209-S1 SAVE_GRAPH_TEMPLATE_WITH_CLONEABLE_INFO
	///------ Tony 07/01/2015 ORG-13209-S1 MORE_PRESET_WHEN_SAVE_GRAPH_TEMPLATE
	BOOL bCloneable = false;
	if(clone && clone.Show)
	///------ End MORE_PRESET_WHEN_SAVE_GRAPH_TEMPLATE
	{
		///------ Tony 07/01/2015 ORG-13209-S1 MORE_PRESET_WHEN_SAVE_GRAPH_TEMPLATE
		//BOOL bCloneable = clone && clone.Use > 0;
		bCloneable = clone.Use > 0;
		///------ End MORE_PRESET_WHEN_SAVE_GRAPH_TEMPLATE
		double dCtrl;
		pg.LT_get_var("page.cntrl", &dCtrl);
		int nCtrl = dCtrl;
		O_SET_BIT(nCtrl, PPDWCNTRL_MARK_AS_CLONEABLE_TEMPLATE, bCloneable);
		pg.LT_set_var("page.cntrl", nCtrl);
		if( bCloneable )
		{
			///------ Tony 07/28/2015 ORG-13209-S4 IMPROVE_SAVE_TEMPLATE_DLG
			//pg.LT_set_var("page.clonematch", clone.match.nVal + PCBMatch_Data_Index);
			///Kyle 09/01/2015 ORG-13327-S2 TEMPLATE_SAVE_AS_CLONE_MATCH_CONTROL_CLEANUP
			/*
			int nMatchData = clone.match.nVal + PCBMatch_Data_Index;
			
			int nMatchSheet = 0;
			if(clone.matchSheet.Show)
				nMatchSheet= (clone.matchSheet.nVal << 4) + PCBMatch_Sheet_Index;
			
			int nMatch = nMatchData + nMatchSheet;
			*/
			double match = 0.0;
			pg.LT_get_var("page.clonematch", &match);
			int nMatch = _combine_match_ctrls(clone.matchcol.nVal, clone.matchsheet.Show ? clone.matchsheet.nVal : -1, (DWORD)match);
			///End TEMPLATE_SAVE_AS_CLONE_MATCH_CONTROL_CLEANUP
			pg.LT_set_var("page.clonematch", nMatch);
			///------ End IMPROVE_SAVE_TEMPLATE_DLG
		}
	}
	
	///------ Tony 08/07/2015 ORG-13209-S5 NOT_ALLOW_SAME_TEMPLATE_NAME
	//update xml before file save, then nReplaceSameNameTemplate and eidt mode will work fine
	TreeNode trAddedTemplate = to.AddTemplate(trCategory, strFullPathFile, NULL, false, bCloneable, bReplaceSameNameTemplate, templateEdit);	
	if(!trAddedTemplate)
		XF_THROW(XFERR_INVALID_OPERATION);
	///------ End NOT_ALLOW_SAME_TEMPLATE_NAME
	
	Tree trMatchModifiers;		///Kyle 11/11/2016 ORG-15418-P1 BATCH_PLOTTING_AND_SAVE_TEMPLATE_AS_OPTIONS_PREVENT_CHANGE_SOURCE_GRAPH
	
	///------ Tony 07/01/2015 ORG-13209-S1 MORE_PRESET_WHEN_SAVE_GRAPH_TEMPLATE
	if( EXIST_PLOT == pg.GetType() )		
	///------ End MORE_PRESET_WHEN_SAVE_GRAPH_TEMPLATE
	{
		///Kyle 11/11/2016 ORG-15418-P1 BATCH_PLOTTING_AND_SAVE_TEMPLATE_AS_OPTIONS_PREVENT_CHANGE_SOURCE_GRAPH
		trMatchModifiers = pg.GetFormat(FPB_OTHER, FOB_OTHER, true, true);
		int nOldMatchBy = trMatchModifiers.Root.Misc.MatchBy.nVal;
		string strOldMatchUDL = trMatchModifiers.Root.Misc.MatchUDL.strVal;
		trMatchModifiers.Reset();
		trMatchModifiers.Root.Misc.MatchBy.nVal = nOldMatchBy;
		trMatchModifiers.Root.Misc.MatchUDL.strVal = strOldMatchUDL;
		pg.UpdateThemeIDs(trMatchModifiers.Root);
		///End BATCH_PLOTTING_AND_SAVE_TEMPLATE_AS_OPTIONS_PREVENT_CHANGE_SOURCE_GRAPH
	
		string strSN = sname;
		strSN.TrimLeft();
		strSN.TrimRight();
		string strLN = lname;
		strLN.TrimLeft();
		strLN.TrimRight();
		
		Tree tr;	
		tr.Root.Misc.PagePresetShortName.strVal = strSN;	
		tr.Root.Misc.PagePresetLongName.strVal = strLN;
		///------ Tony 10/20/2015 ORG-13209-S7 TEMPLATE_SAVEAS_LT_IMPROVE
		/////------ Tony 10/10/2015 ORG-13209-S7 MATCH_MODIFIER_USE_STRING
		///////------ Tony 09/10/2015 ORG-13209-S7 SHOW_MATCH_MODIFIER_TO_SAVE_TEMPLATE
		////tr.Root.Misc.MatchBy.nVal = matchModifiers;
		////if (matchModifiers >= PMMT_USERPARAM && matchModifiers < PMMT_USERPARAM_END)
		////{
			////tr.Root.Misc.MatchUDL.strVal = s_vsMatchByCombo[matchModifiers];
		////}
		///////------ End SHOW_MATCH_MODIFIER_TO_SAVE_TEMPLATE
		//int nMatchModifiers = s_vsMatchByCombo.Find(matchModifiers);
		//if(nMatchModifiers == -1)
			//nMatchModifiers = PMMT_OFFSET;
		//tr.Root.Misc.MatchBy.nVal = nMatchModifiers;
		//if (nMatchModifiers >= PMMT_USERPARAM && nMatchModifiers < PMMT_USERPARAM_END)
		//{
			//tr.Root.Misc.MatchUDL.strVal = matchModifiers;
		//}
		/////------ End MATCH_MODIFIER_USE_STRING
		int nModifierType = _get_modifier_type(pg, matchModifiers);
		tr.Root.Misc.MatchBy.nVal = nModifierType;
		if (nModifierType >= PMMT_USERPARAM && nModifierType < PMMT_USERPARAM_END)
		{
			tr.Root.Misc.MatchUDL.strVal = matchModifiers;
		}
		///------ End TEMPLATE_SAVEAS_LT_IMPROVE
		
		if( 0 == pg.UpdateThemeIDs(tr.Root) )
			pg.ApplyFormat(tr, true, true);
	}
	///End SAVE_GRAPH_TEMPLATE_WITH_CLONEABLE_INFO
	
	
	/// ML 06/02/2017 ORG-15165-P1 template_saveas_USE_NEW_TEMPLATE_EXTENSIONS
	//DWORD	dwCtrl = PAGE_ST_ADD_TO_MRU_LIST; 	/// SY 2007-03-07 QA70-9388 v8.0577 MRU_FOR_TEMPLATE_OGW
	DWORD	dwCtrl = PAGE_ST_ADD_TO_MRU_LIST | PAGE_ST_FMT_BASED_ON_EXTENSION;
	/// end template_saveas_USE_NEW_TEMPLATE_EXTENSIONS
	
	BOOL bRet;
	if(nType == EXIST_PLOT)
	{
		LPCSTR lpcszEMF, lpcszBMP;
		string strEMF(strPath + strTemplate +".emf"), strBMP(strPath + strTemplate +".bmp");
		if( emf && pg.SaveEMF(strEMF) )
			lpcszEMF = strEMF;
		if( bmp && pg.SaveBitmap(strBMP) )
			lpcszBMP = strBMP;
		bRet = pg.SaveTemplate(strFullPathFile, lpcszBMP, lpcszEMF, desc, dwCtrl);	
		///Sophy 11/12/2015 ORG-13757-P7 PROPER_CHECK_TEMPLATES_CHANGE_AND_REFRESH
		PFN_NotifyTemplateLibraryOnSaveTemplate pfn = Project.FindCompiledFunction("NotifyTemplateLibraryOnSaveTemplate");
		if ( pfn )
		{
			pfn(strFullPathFile);
		}
		///end PROPER_CHECK_TEMPLATES_CHANGE_AND_REFRESH
	
	}
	else
		bRet = pg.SaveTemplate(strFullPathFile, NULL, NULL, desc, dwCtrl);	
		
	///Kyle 11/11/2016 ORG-15418-P1 BATCH_PLOTTING_AND_SAVE_TEMPLATE_AS_OPTIONS_PREVENT_CHANGE_SOURCE_GRAPH
	if( trMatchModifiers.Root )
	{
		pg.ApplyFormat(trMatchModifiers, true, true);
	}
	///End BATCH_PLOTTING_AND_SAVE_TEMPLATE_AS_OPTIONS_PREVENT_CHANGE_SOURCE_GRAPH
	///Jasmine 10/23/08 QA80-12442 SHOW_WARNING_WHEN_SAVE_READ_ONLY_FILE	
	if(!bRet)	
	{
		popup_errmsg_save_readonly_file(strFullPathFile);
		XF_THROW(XFERR_INVALID_OPERATION);
	}
	///End SHOW_WARNING_WHEN_SAVE_READ_ONLY_FILE
		
	///Jasmine 04/13/07 PRINT_XF_MSG_TO_SCRIPT_WINDOW
	if(strFullPathFile.IsFile())
	{
		update_recent_path_list(GetFilePath(strFullPathFile));	///Jasmine 07/04/07 ADD_PATH_TRACK
	
		///-----Kit 11/11/2010 ORG-1483-P1 POPUP_MSG_WITH_MSGBOX_WHEN_THE_TEMPLATE_IS_SAME_AS_BULITIN
		//string strMessage;
		/////Cheney 2007-6-18 UPDATE_XF_ERR_THROW_NEED_WAIT_SIM_NEW_FUNC_TO_REPLACE
		////strMessage.Format("Save template as %s", strFullPathFile);
		//ocu_load_msg_str(XF_TEMPLATE_SAVE_SUCCESS, &strMessage, strFullPathFile);
		/////end UPDATE_XF_ERR_THROW_NEED_WAIT_SIM_NEW_FUNC_TO_REPLACE
		/////Folger 04/16/07 REPLACE_BY_OKOC_OUT_MSG
		////xf_print_msg(strMessage);
		//okoc_out_msg(strMessage, 'I');
		/////End REPLACE_BY_OKOC_OUT_MSG
		//
		/////Jasmine 02/04/09 MAX_ASK_SHOW_BUILT_IN_TEMPLATE_HINT_IN_ERRMSG
		/////Jasmine 02/17/09 SHOW_BUILT_IN_MEG_FOR_ALL_TEMPLATE_IN_EXE_FOLDER
		////if(is_built_in_template( nType, template, GetAppPath(TRUE) ) == true)
		//if( _override_exe_folder(strFullPathFile) )
			//okoc_out_msg(_L("A template file with the same name exists in the Origin Program Folder. Origin will use your custom template instead."), 'I');			
		/////End SHOW_BUILT_IN_MEG_FOR_ALL_TEMPLATE_IN_EXE_FOLDER
		string strMessage = "";
		ocu_load_msg_str( XF_TEMPLATE_SAVE_SUCCESS, &strMessage, strFullPathFile );
		okoc_out_msg(strMessage, 'I');
		///-----End POPUP_MSG_WITH_MSGBOX_WHEN_THE_TEMPLATE_IS_SAME_AS_BULITIN
	}
	//------ Folger 08/24/07 USE_TEMPLATE_ORGANIZER_TO_ACCESS_TEMPLATE_XML
	///------ Tony 07/01/2015 ORG-13209-S1 MORE_PRESET_WHEN_SAVE_GRAPH_TEMPLATE
	//to.AddTemplate(trCategory, strFullPathFile);
	///------ Tony 08/07/2015 ORG-13209-S5 NOT_ALLOW_SAME_TEMPLATE_NAME
	//to.AddTemplate(trCategory, strFullPathFile, NULL, false, bCloneable);	
	///------ End NOT_ALLOW_SAME_TEMPLATE_NAME
	///------ End MORE_PRESET_WHEN_SAVE_GRAPH_TEMPLATE
	
	
	/// Iris 2/2/2015 ORG-12578-S1 NOT_ALLOW_SAVE_USER_TEMPLATE_INTO_BUILDIN_CATEGORY
	// in new template library dlg no need to save user attribute and wants to save file path for template file. 
	/*
	octree_delete_nodes_by_missing_attribute(&trXML, STR_USER_PATH_ATTRIB);
	//------ Folger 09/29/07 NEW_DISIGN_FOR_SAVING_TEMPLATE_XML
	octree_remove_attribute(&trXML, STR_FILENAME_ATTRIB);
	*/
	///End NOT_ALLOW_SAVE_USER_TEMPLATE_INTO_BUILDIN_CATEGORY
	_remove_template_label_attribue(trXML);
	//------ End NEW_DISIGN_FOR_SAVING_TEMPLATE_XML
	///Sophy 10/28/08 QA80-12442 SHOW_WARNING_WHEN_SAVE_READ_ONLY_FILE    
	//trXML.Save(STR_TEMPLATE_FILE);
	if( !trXML.Save(STR_TEMPLATE_XML) )
		popup_errmsg_save_readonly_file( STR_TEMPLATE_XML, GetWindow() );
	///end SHOW_WARNING_WHEN_SAVE_READ_ONLY_FILE
	//------ End USE_TEMPLATE_ORGANIZER_TO_ACCESS_TEMPLATE_XML
	///End PRINT_XF_MSG_TO_SCRIPT_WINDOW
	
}

//nEventID < 0 on event, like GETNE_ON_INIT, GETNE_ON_OK etc, >0 on change from control
//return 0 to do nothing, return PEVENT_GETN_RET_TO_CLOSE to close dialog
//dwEnables = bOKEnable, bBTN1Enable, bBTN2Enable, bBTN3Enable, , can set to false to disable OK/Apply buttons
//lpcszNodeName = the trGetN TreeNode tag name that generates the event, or is  if GETNE_ON_OK etc
//strAux = optional string for XF Wizard Bar, like DLG_NEED_CHANGE_GRID etc, it will be invalid if from internal node value change event
//strErrMsg = allowing messages to be shown
int template_saveas_event1(TreeNode& trGetN, int nRow, int nEventID, DWORD& dwEnables, LPCSTR lpcszNodeName, WndContainer& DynaCntrlContainer, string& strAux, string& strErrMsg)
{
	if( xf_is_extended_event(nEventID) )
		return template_saveas_event1_ex(trGetN, nRow, nEventID, dwEnables, lpcszNodeName, DynaCntrlContainer, strAux, strErrMsg);
	DECLARE_BUTTON_ENABLES
	/// ML 06/02/2017 ORG-15165-P1 template_saveas_USE_NEW_TEMPLATE_EXTENSIONS
	s_strPathNameForSaving.Empty();
	/// end template_saveas_USE_NEW_TEMPLATE_EXTENSIONS
	//---- CPY 8/17/06 QA70-8428 ADD_SAVE_AS_OPTION 
	// should not change page display format
	/*
	if(nEventID > 0 && !lstrcmpi(lpcszNodeName, "page"))
	{
		string strPage = trGetN.page.strVal;
		strPage.TrimLeft('[');
		strPage.TrimRight(']');
		Page pg(strPage);
		if(!pg.IsValid())
			return false;
		_on_page_change(pg, trGetN);
	}
	*/
	////find template.xml
	//string strXML = STR_TEMPLATE_XML;
	//if(!strXML.IsFile())
		//construct_template_organizer_tree();
	//------ Folger 08/01/07 INIT_DLG_NO_MATTER_WITH_OR_WITHOUT_DLG
	//if(GETNE_ON_INIT == nEventID)
		//_init_dlg(trGetN);
	//------ End INIT_DLG_NO_MATTER_WITH_OR_WITHOUT_DLG
	//----
	//check
	//------ Folger 08/24/07 USE_TEMPLATE_ORGANIZER_TO_ACCESS_TEMPLATE_XML
	if (nEventID == GETNE_ON_INIT)
	{
		if (!_is_path_allow_saving(trGetN.filepath.strVal))
		{
			strErrMsg = XFERR_PROTECT_SAVE_PATH;
			strErrMsg += ":" + STR_INVALID_SAVE_PATH;//_L("System Folder or Group Folder");
			bOKEnable = false;
			return false;
		}
	}
	//------ End USE_TEMPLATE_ORGANIZER_TO_ACCESS_TEMPLATE_XML
	if(nEventID > 0)
	{
		if(trGetN.category.IsValid() && !lstrlen(trGetN.category.strVal))
		{
			strErrMsg = CWARN_NOT_ADD_TO_TEMPLATE_ORG;
			bOKEnable = false;
			return false;
		}
		if(trGetN.template.IsValid() && !lstrlen(trGetN.template.strVal))
		{
			strErrMsg = CER_EMPTY_VARIABLE;
			///------ Tony 10/27/2015 ORG-13734-S1 BETTER_TEMPLATE_NAME_ERROR_CHECKING
			//strErrMsg +=":"+ "template";
			strErrMsg +=":"+ "Template name";
			///------ End BETTER_TEMPLATE_NAME_ERROR_CHECKING
			bOKEnable = false;
			return false;
		}
		///------ Tony 10/27/2015 ORG-13734-S1 BETTER_TEMPLATE_NAME_ERROR_CHECKING
		else if(!_is_str_valid_for_template(trGetN.template.strVal))
		{
			strErrMsg = XFERR_VARIABLE_CONTAIN_INVALID_CHARACTERS;
			strErrMsg +=":"+ "Template name";
			bOKEnable = false;
			return false;
		}
		///------ End BETTER_TEMPLATE_NAME_ERROR_CHECKING
		if(trGetN.filepath.IsValid() && (!lstrlen(trGetN.filepath.strVal) || !trGetN.filepath.strVal.IsPath()))
		{
			strErrMsg = CER_INVALID_FILEPATH;
			bOKEnable = false;
			return false;
		}
	}
	///Jasmine 10/09/06 WAIT_NEW_SAVEAS_DB
	if(nEventID > 0 && ( !lstrcmpi(lpcszNodeName, "template") || !lstrcmpi(lpcszNodeName, "filepath") ))
	{
		string strFile;
		trGetN.filepath.GetAttribute(STR_FILENAME_ATTRIB, strFile);
		if(!lstrcmpi(lpcszNodeName, "filepath") && trGetN.template)
		{
			string strPath = trGetN.filepath.strVal;//update from editbox
			if(strPath.Right(1).CompareNoCase(OFSEPS))
				strPath += OFSEPS;
			strFile = strPath + GetFileName(strFile);
			trGetN.template.strVal = GetFileName(strFile, true);
			trGetN.filepath.strVal = GetFilePath(strFile);
		}
		///Jasmine 08/12/09 HARD_CODE_TO_GET_FILE_EXTENSION
		//strFile = GetFilePath(strFile) + trGetN.template.strVal + "." + strFile.GetToken(1, '.');
		string strExt;
		separate_file_name_ext(strFile, NULL, &strExt);		
		strFile = GetFilePath(strFile) + trGetN.template.strVal +  "." + strExt;
		///End HARD_CODE_TO_GET_FILE_EXTENSION
		trGetN.filepath.SetAttribute(STR_FILENAME_ATTRIB, strFile);
	}
	//------ Folger 08/24/07 USE_TEMPLATE_ORGANIZER_TO_ACCESS_TEMPLATE_XML
	if (nEventID > 0 && !_is_path_allow_saving(trGetN.filepath.strVal))
	{
		strErrMsg = XFERR_PROTECT_SAVE_PATH;
		strErrMsg += ":" + STR_INVALID_SAVE_PATH;
		bOKEnable = false;
		return false;
	}
	//------ End USE_TEMPLATE_ORGANIZER_TO_ACCESS_TEMPLATE_X