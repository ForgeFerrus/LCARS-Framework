#define MATCH_BY_COMBO _L("Index|Short Name|Long Name")

enum
{
	MATCH_BY_INDEX = 0,
	MATCH_BY_SHORT_NAME,
	MATCH_BY_LONG_NAME,
};

///------ Tony 10/27/2015 ORG-13734-S1 BETTER_TEMPLATE_NAME_ERROR_CHECKING
static bool _is_str_valid_for_template(const string& strTemplate)
{
	if(!is_str_valid_for_filename(strTemplate))
	{
		return false;
	}
	else
	{
		strTemplate.TrimLeft();
		strTemplate.TrimRight();
		if ( strTemplate.IsEmpty() )
			return false;
		
		if( strTemplate.FindOneOf("$") != -1 )
			return false;
	}
	
	return true;
}
///------ End BETTER_TEMPLATE_NAME_ERROR_CHECKING

///Kyle 09/01/2015 ORG-13327-S2 TEMPLATE_SAVE_AS_CLONE_MATCH_CONTROL_CLEANUP
static DWORD	_combine_match_ctrls(int nMatchData, int nMatchSheet, DWORD dwCloneMatch)
{
	DWORD dwMatchData = 0;
	switch( nMatchData )
	{
	default:
		ASSERT(FALSE);	// fall down
	case MATCH_BY_INDEX:
		dwMatchData = PCBMatch_Data_Index;
		break;

	case MATCH_BY_SHORT_NAME:
		dwMatchData = PCBMatch_Data_ShortName;
		break;
		
	case MATCH_BY_LONG_NAME:
		dwMatchData = PCBMatch_Data_LongName;
		break;
	}
	O_SET_NBITS(dwCloneMatch, PCBMatch_Data_Mask, dwMatchData);

	if( nMatchSheet >= 0 )
	{
		DWORD dwMatchSheet = 0;
		switch( nMatchSheet )
		{
		case MATCH_BY_INDEX:
			dwMatchSheet = PCBMatch_Sheet_Index;
			break;

		case MATCH_BY_SHORT_NAME:
			dwMatchSheet = PCBMatch_Sheet_ShortName;
			break;
		
		case MATCH_BY_LONG_NAME:
			dwMatchSheet = PCBMatch_Sheet_LongName;
			break;
		}
		O_SET_NBITS(dwCloneMatch, PCBMatch_Sheet_Mask, dwMatchSheet);
	}

	return dwCloneMatch;
}

static void _split_match_ctrls(DWORD dwCloneMatch, int& nMatchData, int& nMatchSheet)
{
	switch( dwCloneMatch & PCBMatch_Data_Mask )
	{
	case PCBMatch_Data_Index:
		nMatchData = MATCH_BY_INDEX;
		break;

	case PCBMatch_Data_ShortName:
		nMatchData = MATCH_BY_SHORT_NAME;
		break;
		
	case PCBMatch_Data_LongName:
		nMatchData = MATCH_BY_LONG_NAME;
		break;
		
	default:
		nMatchData = -1;
	}

	switch( dwCloneMatch & PCBMatch_Sheet_Mask )
	{
	case PCBMatch_Sheet_Index:
		nMatchSheet = MATCH_BY_INDEX;
		break;

	case PCBMatch_Sheet_ShortName:
		nMatchSheet = MATCH_BY_SHORT_NAME;
		break;
		
	case PCBMatch_Sheet_LongName:
		nMatchSheet = MATCH_BY_LONG_NAME;
		break;
		
	default:
		nMatchSheet = -1;
	}
}

static void _init_cloneable_settings(TreeNode& trGetN, Page pg, int nGetNDialog, DWORD dwCntrl)
{
	ASSERT( is_xf_startup(nGetNDialog, dwCntrl) );

	if( EXIST_PLOT != pg.GetType() )
	{
		trGetN.clone.Show = false;
		trGetN.clone.Use = false;
		return;
	}

	DWORD dwFlags;
	GraphPage gp = pg;
	trGetN.clone.Show = gp.IsCloneableEnabled(&dwFlags);
	if( !trGetN.clone.Show )
	{
		trGetN.clone.Use = false;
		return;
	}

	bool bCloneable = false;
	bool bShowMatchSheet = dwFlags & PCloneableFlg_SrcCrossSheet;
	
	///------ Tony 10/14/2015 ORG-13209-S1 MORE_PRESET_WHEN_SAVE_GRAPH_TEMPLATE 
	//int nMatchData, nMatchSheet;
	int nMatchData = trGetN.clone.matchcol.nVal;
	int nMatchSheet = trGetN.clone.matchsheet.nVal;
	///------ End MORE_PRESET_WHEN_SAVE_GRAPH_TEMPLATE 
	// read graph settings
	{
		double dCtrl;
		if(pg.LT_get_var("page.cntrl", &dCtrl))
			bCloneable = O_QUERY_BOOL((int)dCtrl, PPDWCNTRL_MARK_AS_CLONEABLE_TEMPLATE);

		double match = 0.0;
		pg.LT_get_var("page.clonematch", &match);
		_split_match_ctrls((DWORD)match, nMatchData, nMatchSheet);
	}

	// init from data if graph has plots and this dialog is open
	if( (dwCntrl & LTXF_SHOW_DIALOG) && !(dwFlags & PCloneableFlg_StyleHolderHasSrcInfos) )
	{
		int nLayerHasPlot = 0;
		bool bOneGroup = true;
		_get_info_from_graph_page(pg, nLayerHasPlot, bOneGroup);
		ASSERT( nLayerHasPlot > 0 );

		if(dwFlags & PCloneableFlg_SrcModiLabelUnreliable)
			bCloneable = false;
		else if(!bCloneable)
		{
			//When all data plots in one layer of the graph page, and these plots area all in one group, or un group, bCloneable = false
			if(!bOneGroup || nLayerHasPlot > 1)
				bCloneable = true;
		}

		if( nMatchData < 0 )
			nMatchData = MATCH_BY_INDEX;
		if( nMatchSheet < 0 )
			nMatchSheet = MATCH_BY_INDEX;
	
		//if not all col has long name, then set PCBMatch_Data_Index
		bool bColLongNameReliable = dwFlags & PCloneableFlg_SrcDataLongNameReliable;
		if(bColLongNameReliable)
			nMatchData = MATCH_BY_LONG_NAME;
		else if(MATCH_BY_LONG_NAME == nMatchData )
			nMatchData = MATCH_BY_INDEX;

		bool bSheetLongNameReliable = dwFlags & PCloneableFlg_SrcSheetLongNameReliable;
		if(bSheetLongNameReliable)
			nMatchSheet = MATCH_BY_LONG_NAME;
		else if(MATCH_BY_LONG_NAME == nMatchSheet)
			nMatchSheet = MATCH_BY_INDEX;
	}
	///------ Tony 10/14/2015 ORG-13209-S1 MORE_PRESET_WHEN_SAVE_GRAPH_TEMPLATE 
	//if( nMatchData < 0 )
		//nMatchData = MATCH_BY_INDEX;
	//if( nMatchSheet < 0 )
		//nMatchSheet = MATCH_BY_INDEX;
	//
	//trGetN.clone.Use				= bCloneable;
	//trGetN.clone.matchcol.nVal		= nMatchData;
	//trGetN.clone.matchsheet.Show	= bShowMatchSheet;
	//trGetN.clone.matchsheet.nVal	= nMatchSheet;
	trGetN.clone.matchsheet.Show	= bShowMatchSheet;
	if( dwCntrl & LTXF_SHOW_DIALOG)
	{
		if( nMatchData < 0  )
			nMatchData = MATCH_BY_INDEX;
		if( nMatchSheet < 0 )
			nMatchSheet = MATCH_BY_INDEX;
		
		trGetN.clone.Use				= bCloneable;
		trGetN.clone.matchcol.nVal		= nMatchData;
		trGetN.clone.matchsheet.nVal	= nMatchSheet;
	}
	else
	{
		if( nMatchData < 0  )
		{
			trGetN.clone.matchcol.nVal = MATCH_BY_INDEX;
		}
		if( nMatchSheet < 0 )
		{
			trGetN.clone.matchsheet.nVal = MATCH_BY_INDEX;
		}
	}
	///------ End MORE_PRESET_WHEN_SAVE_GRAPH_TEMPLATE 
}
///End TEMPLATE_SAVE_AS_CLONE_MATCH_CONTROL_CLEANUP

///------ Tony 09/14/2015 ORG-13209-S8 SHOW_WARNING_MESSAGE_FOR_UNRELIABLE_LN_AND_LABEL_ROW
static bool _check_show_unreliable_message(string& strErrMsg, bool& bOKEnable, Page& pg, TreeNode& trGetN)
{
	if( EXIST_PLOT != pg.GetType() || !trGetN.clone || trGetN.clone.Show == false
		|| !trGetN.clone.matchcol || !trGetN.clone.matchsheet || !trGetN.matchModifiers)
	{
		return false;
	}
	
	bool bCloneableMark = trGetN.clone.Use;
	int nMatchData = trGetN.clone.matchcol.nVal;
	int nMatchSheet = trGetN.clone.matchsheet.nVal;

	///------ Tony 10/20/2015 ORG-13209-S7 TEMPLATE_SAVEAS_LT_IMPROVE
	/////------ Tony 10/10/2015 ORG-13209-S7 MATCH_MODIFIER_USE_STRING
	////int nMatchModifiers = trGetN.matchModifiers.nVal;
	//string strMatchModifiers = trGetN.matchModifiers.strVal;
	//int nMatchModifiers = s_vsMatchByCombo.Find(strMatchModifiers);
	//if(nMatchModifiers == -1)
		//nMatchModifiers = PMMT_OFFSET;
	/////------ End MATCH_MODIFIER_USE_STRING
	string strMatchModifiers = trGetN.matchModifiers.strVal;
	int nModifierType = _get_modifier_type(pg, strMatchModifiers);
	///------ End TEMPLATE_SAVEAS_LT_IMPROVE

	GraphPage gp = pg;
	//set match modifiers
	TreeNode tr = gp.GetFormat(FPB_OTHER, FOB_OTHER, true, true);
	//save the old ones in order to get the dwFlags(PCloneableFlg_SrcModiLabelUnreliable), must restore them after done
	int nOldMatchBy = tr.Root.Misc.MatchBy.nVal;
	string strOldMatchUDL = tr.Root.Misc.MatchUDL.strVal;
	///------ Tony 10/20/2015 ORG-13209-S7 TEMPLATE_SAVEAS_LT_IMPROVE
	//tr.Root.Misc.MatchBy.nVal = nMatchModifiers;
	//if (nMatchModifiers >= PMMT_USERPARAM && nMatchModifiers < PMMT_USERPARAM_END)
	//{
		//tr.Root.Misc.MatchUDL.strVal = s_vsMatchByCombo[nMatchModifiers];
	//}		
	///Kyle 09/23/2016 ORG-15294-P1 TEMPLATE_SAVE_AS_PREVENT_APPLY_PANEL_COLUMNS
	/*
	tr.Root.Misc.MatchBy.nVal = nModifierType;
	if (nModifierType >= PMMT_USERPARAM && nModifierType < PMMT_USERPARAM_END)
	{
		tr.Root.Misc.MatchUDL.strVal = strMatchModifiers;
	}
	*/
	Tree trFormat;
	trFormat.Root.Misc.MatchBy.nVal = nModifierType;
	if (nModifierType >= PMMT_USERPARAM && nModifierType < PMMT_USERPARAM_END)
	{
		trFormat.Root.Misc.MatchUDL.strVal = strMatchModifiers;
	}
	///End TEMPLATE_SAVE_AS_PREVENT_APPLY_PANEL_COLUMNS
	///------ End TEMPLATE_SAVEAS_LT_IMPROVE
	///Kyle 09/23/2016 ORG-15294-P1 TEMPLATE_SAVE_AS_PREVENT_APPLY_PANEL_COLUMNS
	//pg.ApplyFormat(tr, true, true);
	pg.UpdateThemeIDs(trFormat.Root);
	pg.ApplyFormat(trFormat, true, true);
	///End TEMPLATE_SAVE_AS_PREVENT_APPLY_PANEL_COLUMNS
	
	DWORD dwFlags;
	bool bCloneEnabled = gp.IsCloneableEnabled(&dwFlags);
	
	//restore
	///Kyle 09/23/2016 ORG-15294-P1 TEMPLATE_SAVE_AS_PREVENT_APPLY_PANEL_COLUMNS
	/*
	tr.Root.Misc.MatchBy.nVal = nOldMatchBy;
	tr.Root.Misc.MatchUDL.strVal = strOldMatchUDL;
	pg.ApplyFormat(tr, true, true);
	*/
	trFormat.Root.Misc.MatchBy.nVal = nOldMatchBy;
	trFormat.Root.Misc.MatchUDL.strVal = strOldMatchUDL;
	pg.UpdateThemeIDs(trFormat.Root);
	pg.ApplyFormat(trFormat, true, true);
	///End TEMPLATE_SAVE_AS_PREVENT_APPLY_PANEL_COLUMNS
	
	if( bCloneEnabled && !(dwFlags & PCloneableFlg_StyleHolderHasSrcInfos) )
	{
		if(!(PCloneableFlg_SrcDataLongNameReliable & dwFlags) && bCloneableMark && MATCH_BY_LONG_NAME == nMatchData)
		{
			strErrMsg = XFWARN_EMPTY_DUPLICATE_COLUMN_LONG_NAME;
			bOKEnable = false;
			return true;
		}
		
		if(!(PCloneableFlg_SrcSheetLongNameReliable & dwFlags) && bCloneableMark && MATCH_BY_LONG_NAME == nMatchSheet)
		{
			strErrMsg = XFWARN_EMPTY_DUPLICATE_SHEET_LONG_NAME;
			bOKEnable = false;
			return true;
		}
		
		
		if(PCloneableFlg_SrcModiLabelUnreliable & dwFlags)
		{
			strErrMsg = XFWARN_EMPTY_DUPLICATE_MODIFIER_LABEL;
			bOKEnable = false;
			return true;
		}
	}
	
	return false;
}
///------ End SHOW_WARNING_MESSAGE_FOR_UNRELIABLE_LN_AND_LABEL_ROW


