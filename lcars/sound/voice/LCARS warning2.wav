//put your own support static functions here
static string s_strErrMsg = "";	///Jasmine 08/26/10 ORG-389-P8 CHECK_ERROR_AT_THE_BEGINNING

///Jasmine 04/20/20011 ORG-389-S7 SHOW_SLIDER_FOR_CUTOFF
static void _set_slider(TreeNode& trNode, LPCSTR lpczSlider)
{
	trNode.ID = TRGP_SLIDEREDIT;
	trNode.SetAttribute(STR_COMBO_ATTRIB, lpczSlider);
}

#define	_CHECK_SET_CUTOFF_NODE_RANGE(_TN, _SLIDER, LABEL)				\
		if(_TN.Show != false)											\
		{																\
			_set_slider(_TN, _SLIDER);									\
			if( !_cutoff_check_in_range(_TN.dVal, LABEL, strErrMsg) )	\
			return false;												\
		}	
		
#define	_CHECK_SET_CUTOFF_NODE_MINIMUN(_TN, _SLIDER, LABEL)				\
		if(_TN.Show != false)											\
		{																\
			_set_slider(_TN, _SLIDER);									\
			if( !_check_larger_than(_TN, LABEL, 0, strErrMsg) )			\
				return false;											\
		}
///End SHOW_SLIDER_FOR_CUTOFF

///Jasmine 09/10/10 ORG-950-P3 GIVE_BETTER_ERROR_MESSAGE
static  bool _check_input(TreeNode& trGetN, string& strErrMsg)
{
	// No input matrix
	MatrixObject im;
	if(!okxf_resolve_string_get_origin_object(trGetN.im.strVal, &im)||!im.HasData(false))
	{
	
		if ( !im.IsValid() )
			strErrMsg = XFERR_NO_INPUT_DATA_MATRIX;
		else
		{
			strErrMsg = CER_NEED_CVT_TO_DATA;
		}
	}
	
	// cutoff, lower cutoff and upper cutoff must be in range (0,0.5) if specified in fraction
	if(trGetN.type.nVal == type_fraction)
	{
		///Jasmine 04/20/20011 ORG-389-S7 SHOW_SLIDER_FOR_CUTOFF
		/*
		if( trGetN.cutoff.Show != false && !_cutoff_check_in_range(trGetN.cutoff.dVal, _L("Cutoff"), strErrMsg) )
			return false;
		
		if( trGetN.lowercut.Show != false && !_cutoff_check_in_range(trGetN.lowercut.dVal, _L("Lower cutoff"), strErrMsg) )
			return false;
		
		if( trGetN.uppercut.Show != false && !_cutoff_check_in_range(trGetN.uppercut.dVal, _L("Upper cutoff"), strErrMsg) )
			return false;
		*/
		string strSlider = "0|0.5|10";
		_CHECK_SET_CUTOFF_NODE_RANGE( trGetN.cutoff, strSlider, _L("Cutoff") )	
		_CHECK_SET_CUTOFF_NODE_RANGE( trGetN.lowercut, strSlider, _L("Lower cutoff") )
		_CHECK_SET_CUTOFF_NODE_RANGE( trGetN.uppercut, strSlider, _L("Upper cutoff") )
		///End SHOW_SLIDER_FOR_CUTOFF
	}
	else// cutoff, lower cutoff and upper cutoff must > 0
	{
		///Jasmine 04/20/20011 ORG-389-S7 SHOW_SLIDER_FOR_CUTOFF
		/*
		if( trGetN.cutoff.Show != false && !_check_larger_than(trGetN.cutoff, _L("Cutoff"), 0, strErrMsg) )
			return false;
		
		if( trGetN.lowercut.Show != false && !_check_larger_than(trGetN.lowercut, _L("Lower cutoff"), 0, strErrMsg) )
			return false;
		
		if( trGetN.uppercut.Show != false && !_check_larger_than(trGetN.uppercut, _L("Upper cutoff"), 0, strErrMsg) )
			return false;
		*/
		string strSlider = "0|100|100";
		_CHECK_SET_CUTOFF_NODE_MINIMUN(trGetN.cutoff, strSlider, _L("Cutoff"))
		_CHECK_SET_CUTOFF_NODE_MINIMUN(trGetN.lowercut, strSlider, _L("Lower cutoff"))
		_CHECK_SET_CUTOFF_NODE_MINIMUN(trGetN.uppercut, strSlider, _L("Upper cutoff"))
		///End SHOW_SLIDER_FOR_CUTOFF
	}
	
	// If present, lower cutoff must be smaller than upper cutoff  
	if( trGetN.lowercut.Show && trGetN.uppercut.Show )
	{
		if(trGetN.type.nVal != type_wavelength && trGetN.lowercut.dVal >= trGetN.uppercut.dVal)
		{
			strErrMsg = XFERR_FFT_FILTER2_INVALID_CUTOFF;
			return false;		
		}
		//lower cutoff must be larger than upper cutoff for wavelength 
		if(trGetN.type.nVal == type_wavelength && trGetN.lowercut.dVal <= trGetN.uppercut.dVal)
		{
			strErrMsg = XFERR_FFT_FILTER2_INVALID_WAVELENGTH;
			return false;		
		}
	}
	
	// If present, thresh must be in range [0,1], and thresh2 < thresh1
	if( trGetN.filter.nVal == filter_threshold )
	{
		if( trGetN.lowerthre.Show != false && !_threshold_check_in_range(trGetN.lowerthre.dVal, _L("Lower threshold"), strErrMsg) )
			return false;
		
		if( trGetN.upperthre.Show != false && !_threshold_check_in_range(trGetN.upperthre.dVal, _L("Upper threshold"), strErrMsg) )
			return false;
		
		if( trGetN.lowerthre.Show != false && trGetN.upperthre.Show != false && trGetN.lowerthre.dVal >= trGetN.upperthre.dVal )
		{
			strErrMsg = XFERR_FFT_FILTER2_INVALID_THRESHOLD;
			return false;
		}		
	}
	
	//order must > 0
	if( trGetN.order.Show && !_check_larger_than(trGetN.order, _L("Order"), 0, strErrMsg) )
	{
		return false;
	}		
	///Mori 10/29/2013 ORG-7535 UNAVAILABLE_BAND_PASS_AND_BLOCK_WHEN_BLACKMAN
	if( trGetN.window.nVal == window_blackman )
	{
		if( trGetN.filter.nVal == filter_bandpass || trGetN.filter.nVal == filter_bandblock )
		{
			strErrMsg = _L("Band pass/block filter type is not applicable to Blackman window type.");
			return false;
		}
	}
	///End UNAVAILABLE_BAND_PASS_AND_BLOCK_WHEN_BLACKMAN
	return strErrMsg.IsEmpty();
}

//check if in (0, 0.5]
static bool _cutoff_check_in_range(double dValue, LPCSTR lpczName, string& strErrMsg)
{
	if( dValue <= 0 || dValue > 0.5 )
	{
		strErrMsg.Format("%d:%s|0|0.5", XFERR_VALUE_OUT_OF_RANGE, lpczName);
		return false;
	}
	
	return true;
}

//check if in [0, 1]
static bool _threshold_check_in_range(double dValue, LPCSTR lpczName, string& strErrMsg)
{
	if( dValue < 0 || dValue > 1 )
	{
		strErrMsg.Format("%d:%s|0|1", XFERR_VALUE_OUT_OF_RANGE, lpczName);
		return false;
	}
	
	return true;
}

//check if > dValue
static bool _check_larger_than(const TreeNode& trNode, LPCSTR lpczName, double dValue, string& strErrMsg)
{
	if( trNode.dVal <= dValue )
	{
		strErrMsg.Format("%d:%s|%g", XFERR_VALUE_LARGER_THAN_A_NUMBER, lpczName, dValue);
		return false;
	}
	
	return true;
}
///End GIVE_BETTER_ERROR_MESSAGE
static void _update_method_show(TreeNode& trGetN)
{
	
	trGetN.filter.Show = true;
	
	switch(trGetN.filter.nVal)
	{		
	case filter_low:
		trGetN.window.Show		= true;
		trGetN.cutoff.Show		= true;
		trGetN.lowercut.Show	= false;
		trGetN.uppercut.Show	= false;
		trGetN.lowerthre.Show	= false;
		trGetN.upperthre.Show	= false;
		trGetN.type.Show 		= true;
		break;		
	case filter_high:
		trGetN.window.Show		= true;
		trGetN.cutoff.Show		= true;
		trGetN.lowercut.Show	= false;
		trGetN.uppercut.Show	= false;
		trGetN.lowerthre.Show	= false;
		trGetN.upperthre.Show	= false;		
		trGetN.type.Show		= true;
		break;
	case filter_bandpass:
		trGetN.window.Show		= true;
		trGetN.cutoff.Show		= false;
		trGetN.lowercut.Show	= true;
		trGetN.uppercut.Show	= true;
		trGetN.lowerthre.Show	= false;
		trGetN.upperthre.Show	= false;		
		trGetN.type.Show 		= true;
		break;
	case filter_bandblock:
		trGetN.window.Show		= true;
		trGetN.cutoff.Show		= false;
		trGetN.lowercut.Show 	= true;
		trGetN.uppercut.Show 	= true;
		trGetN.lowerthre.Show	= false;
		trGetN.upperthre.Show	= false;			
		trGetN.type.Show 		= true;
		break;
	case filter_threshold:
		trGetN.window.Show		= false;
		trGetN.cutoff.Show		= false;
		trGetN.lowercut.Show 	= false;
		trGetN.uppercut.Show 	= false;
		trGetN.lowerthre.Show	= true;
		trGetN.upperthre.Show	= true;	
		trGetN.type.Show 		= false;
		break;
	default:
		break;
	}
	
	trGetN.order.Show = ( trGetN.window.Show && trGetN.window.nVal == window_butterworth );
	
	trGetN.zerocut.Show = false;		///Jasmine 08/30/10 ORG-389-P9 ONLY_SHOW_ZEROCUT_IF_BLACKMAN_WINDOW
	if( trGetN.window.Show && trGetN.window.nVal == window_blackman )
	{
		trGetN.cutoff.Show 	= 
		trGetN.lowercut.Show= 
		trGetN.uppercut.Show= 
		trGetN.type.Show 	= false;	
		
		trGetN.zerocut.Show = true;///Jasmine 08/30/10 ORG-389-P9 ONLY_SHOW_ZEROCUT_IF_BLACKMAN_WINDOW
	}
	
	
	bool bPixel = trGetN.type.nVal == type_pixel;
	bool bFraction = trGetN.type.nVal == type_fraction;	
	bool bWavelength = trGetN.type.nVal == type_wavelength;
	bool bHertz = trGetN.type.nVal == type_hertz;
	bool bShow = trGetN.cutoff.Show;
	trGetN.cutoffhint1.Show = bShow && !bPixel;
	//trGetN.cutoffhint2.Show = bShow && !bFraction;	///Jasminie 09/02/10 ORG-950-P2 HIDE_FRACTION_HINTS	
	trGetN.cutoffhint3.Show = bShow && !bWavelength && !bFraction;
	trGetN.cutoffhint4.Show = bShow && !bHertz && !bFraction;
	
	bShow = trGetN.lowercut.Show;
	trGetN.lowercuthint1.Show = bShow && !bPixel;
	//trGetN.lowercuthint2.Show = bShow && !bFraction;	///Jasminie 09/02/10 ORG-950-P2 HIDE_FRACTION_HINTS
	trGetN.lowercuthint3.Show = bShow && !bWavelength && !bFraction;
	trGetN.lowercuthint4.Show = bShow && !bHertz && !bFraction;
	
	bShow = trGetN.uppercut.Show;
	trGetN.uppercuthint1.Show = bShow && !bPixel;
	//trGetN.uppercuthint2.Show = bShow && !bFraction;	///Jasminie 09/02/10 ORG-950-P2 HIDE_FRACTION_HINTS
	trGetN.uppercuthint3.Show = bShow && !bWavelength && !bFraction;
	trGetN.uppercuthint4.Show = bShow && !bHertz && !bFraction;  

}

static void _cutoff_conversion(double cutoff, int nSpeicifyCutoffBy, int nRows, int nCols, double& pixel, double& fraction, double& wavelength, double& hertz)
{	

	switch( nSpeicifyCutoffBy )
	{
	case type_fraction:
		fraction  = cutoff;
		pixel     = sqrt((nRows/2.0)^2+(nCols/2.0)^2) * fraction;
		///Jasmine 09/08/10 ORG-1004 GET_COVERTED_VALUE_ON_TYPE_CHANGE
		wavelength	= (nCols - 1.0) / pixel;  
		hertz 		= pixel / nCols;  
		///End GET_COVERTED_VALUE_ON_TYPE_CHANGE
		break;
	
	case type_pixel:
		pixel		= cutoff;
		//fraction	= pixel / (nCols >>1 );	///Jasminie 09/02/10 ORG-950-P2 HIDE_FRACTION_HINTS
		fraction	= pixel/sqrt((nRows/2.0)^2+(nCols/2.0)^2);///Jasmine 09/08/10 ORG-1004 GET_COVERTED_VALUE_ON_TYPE_CHANGE
		///Jasmine 08/31/10 ORG-389-P4 FIX_WRONG_RELATION_BETWEEN_PIXEL_AND_WAVELENGTH_ETC
		//wavelength = 1.0 / (nCols - 1) * pixel;  
        //hertz      = 1.0 / wavelength; 
        wavelength	= (nCols - 1.0) / pixel;  
		hertz 		= pixel / nCols;  
		break;
	
	case type_wavelength:
		wavelength= cutoff;
		//fraction  = pixel / (nCols >>1 );	///Jasminie 09/02/10 ORG-950-P2 HIDE_FRACTION_HINTS
		//pixel     = wavelength * (nCols - 1);
		//hertz     = 1.0 / wavelength;
		pixel     = (nCols - 1.0) / wavelength;
		fraction	= pixel/sqrt((nRows/2.0)^2+(nCols/2.0)^2);///Jasmine 09/08/10 ORG-1004 GET_COVERTED_VALUE_ON_TYPE_CHANGE
		
		hertz     = pixel / nCols;
		break;
	
	case type_hertz:
		hertz      = cutoff;
		//fraction   = pixel / (nCols >>1 );	///Jasminie 09/02/10 ORG-950-P2 HIDE_FRACTION_HINTS
		//wavelength = 1.0 / hertz; 
		//pixel      =  wavelength * (nCols - 1);
		pixel      = hertz * nCols;	
		fraction	= pixel/sqrt((nRows/2.0)^2+(nCols/2.0)^2);///Jasmine 09/08/10 ORG-1004 GET_COVERTED_VALUE_ON_TYPE_CHANGE
		
		wavelength = (nCols - 1.0) / pixel;  
		///End FIX_WRONG_RELATION_BETWEEN_PIXEL_AND_WAVELENGTH_ETC
		break;
	default:
		break;
	}	
}

static int _option_conversion(int nFilterType, int nWinType, int nCutoffForm, int bZeroCut)
{
	int nFilterType_bits, nWinType_bits, nCutoffForm_bits, nZeroCut_bits;
	
	switch( nFilterType )
	{
	case filter_low:
		nFilterType_bits = FILTER2D_LOW_PASS;
		break;
	case filter_high:
		nFilterType_bits = FILTER2D_HIGH_PASS;
		break;
	case filter_bandpass:
		nFilterType_bits = FILTER2D_BAND_PASS;
		break;
	case filter_bandblock:
		nFilterType_bits = FILTER2D_BAND_BLOCK;
		break;
	default:
		return 0;
		break;		
	}
	
	switch( nWinType )
	{
	case window_butterworth:
		nWinType_bits = FILTER2D_BUTTERWORTH;
		break;
	case window_ideal:
		nWinType_bits = FILTER2D_IDEAL;
		break;
	case window_gaussian:
		nWinType_bits = FILTER2D_GAUSSIAN;
		break;
	case window_blackman:
		nWinType_bits = FILTER2D_BLACKMAN;
		break;
	default:
		return 0;
		break;		
	}
	
	///Jasmine 08/31/10 ORG-950-P1 CUTOFF_SHOULD_ONLY_IN_FRACTION_IF_WINTYPE_IS_BLACKMAN
	if(FILTER2D_BLACKMAN == nWinType)
	{
		nCutoffForm_bits = FILTER2D_CUTOFF_IN_FRACTION;
	}
	else
	///End CUTOFF_SHOULD_ONLY_IN_FRACTION_IF_WINTYPE_IS_BLACKMAN
	{
		switch( nCutoffForm )
		{
		case type_pixel:
			nCutoffForm_bits = FILTER2D_CUTOFF_IN_FOURIER_PIXELS;
			break;
		case type_fraction:
			nCutoffForm_bits = FILTER2D_CUTOFF_IN_FRACTION;
			break;
		case type_wavelength:
			nCutoffForm_bits = FILTER2D_CUTOFF_IN_FOURIER_PIXELS;
			break;
		case type_hertz:
			nCutoffForm_bits = FILTER2D_CUTOFF_IN_FOURIER_PIXELS;
			break;
		default:
			return 0;
			break;		
		}
	}

	///Jasmine 08/31/10 ORG-950-P1 ZEROCUT_ONLY_FOR_BLACKMAN_WINTYPE
	//switch( bZeroCut )
	//{
	//case 0:
		//nZeroCut_bits = 0;
		//break;
	//case 1:
		//nZeroCut_bits = FILTER2D_ZERO_OUTSIDE_CIRCLE;
		//break;
	//default:
		//return 0;
		//break;		
	//}	
	nZeroCut_bits = 0;
	if(FILTER2D_BLACKMAN == nWinType && bZeroCut)
		nZeroCut_bits = FILTER2D_ZERO_OUTSIDE_CIRCLE;
	///End ZEROCUT_ONLY_FOR_BLACKMAN_WINTYPE
	
	int option = nFilterType_bits | nWinType_bits | nCutoffForm_bits | nZeroCut_bits;
	
	return option;
}

///Jasmine 09/08/10 ORG-1004 GET_COVERTED_VALUE_ON_TYPE_CHANGE
struct CUTOFFVALUES
{
	double pixel;
	double fraction;
	double wavelength;
	double hertz;
};

static CUTOFFVALUES s_cutoff;
static CUTOFFVALUES s_lowercut;
static CUTOFFVALUES s_uppercut;

enum{
	CALULATE_CUTOFFVALUE		= 0x0001, 
	CALULATE_LOWER_CUTOFFVALUE	= 0x0002,
	CALULATE_UPPER_CUTOFFVALUE	= 0x0004,
};
///End GET_COVERTED_VALUE_ON_TYPE_CHANGE

#define _VALUE_STR		": %g"
static void _set_hints(TreeNode& trNode, LPCSTR lpczHints, double dValue)
{
	//if(trNode.Show)///Jasmine 09/08/10 ORG-1004 GET_COVERTED_VALUE_ON_TYPE_CHANGE
 	{
 		string strHint = lpczHints;
 		
 		string strValue = ": --"; 		
		if( !is_missing_value(dValue) )
			strValue.Format(_VALUE_STR, dValue);		
			
		trNode.SetAttribute(STR_LABEL_ATTRIB, strHint+strValue);
	}
}
static void _update_cutoff_hint_label(TreeNode& trGetN, DWORD dwCalculate = CALULATE_CUTOFFVALUE|CALULATE_LOWER_CUTOFFVALUE|CALULATE_UPPER_CUTOFFVALUE)
{	
    int nSpeicifyCutoffBy = trGetN.type.nVal;
        
    MatrixObject im;
    okxf_resolve_string_get_origin_object(trGetN.im.strVal, &im);	
    int nRows = im? im.GetNumRows() : 0;
    int nCols = im? im.GetNumCols() : 0;
    
	double cutoff, pixel,fraction, wavelength,hertz;
    string strHint;
	string strValue = ": --";
	
	///Jasmine 09/08/10 ORG-1004 GET_COVERTED_VALUE_ON_TYPE_CHANGE
	//if(trGetN.cutoff.Show)
	if(dwCalculate & CALULATE_CUTOFFVALUE)
	///End GET_COVERTED_VALUE_ON_TYPE_CHANGE
	{
		cutoff = trGetN.cutoff.dVal;
		_cutoff_conversion(cutoff, nSpeicifyCutoffBy, nRows, nCols, pixel, fraction, wavelength, hertz);
		///Jasmine 09/08/10 ORG-1004 GET_COVERTED_VALUE_ON_TYPE_CHANGE
		s_cutoff.pixel 		= pixel;
		s_cutoff.fraction	= fraction;
		s_cutoff.wavelength	= wavelength;
		s_cutoff.hertz		= hertz;
		///End GET_COVERTED_VALUE_ON_TYPE_CHANGE
		
		_set_hints(trGetN.cutoffhint1, _L("Cutoff in Pixel"), pixel);
		
		//_set_hints(trGetN.cutoffhint2, _L("Cutoff in Fraction"), fraction);			///Jasminie 09/02/10 ORG-950-P2 HIDE_FRACTION_HINTS
		
		_set_hints(trGetN.cutoffhint3, _L("Cutoff in Wavelength"), wavelength);
		
		_set_hints(trGetN.cutoffhint4, _L("Cutoff in Hertz"), hertz);
	}		
    
	///Jasmine 09/08/10 ORG-1004 GET_COVERTED_VALUE_ON_TYPE_CHANGE
	//if( trGetN.lowercut.Show && trGetN.uppercut.Show)
	if(dwCalculate & CALULATE_LOWER_CUTOFFVALUE)
	///End GET_COVERTED_VALUE_ON_TYPE_CHANGE
	{
		cutoff = trGetN.lowercut.dVal;
		_cutoff_conversion(cutoff, nSpeicifyCutoffBy,nRows, nCols, pixel,fraction, wavelength,hertz);	
		///Jasmine 09/08/10 ORG-1004 GET_COVERTED_VALUE_ON_TYPE_CHANGE
		s_lowercut.pixel 		= pixel;
		s_lowercut.fraction		= fraction;
		s_lowercut.wavelength	= wavelength;
		s_lowercut.hertz		= hertz;
		///End GET_COVERTED_VALUE_ON_TYPE_CHANGE
		
		_set_hints(trGetN.lowercuthint1, _L("Lower Cutoff in Pixels"), pixel);
		
		//_set_hints(trGetN.lowercuthint2, _L("Lower Cutoff in Fraction"), fraction);	///Jasminie 09/02/10 ORG-950-P2 HIDE_FRACTION_HINTS	
		
		_set_hints(trGetN.lowercuthint3, _L("Lower Cutoff in Wavelength"), wavelength);
	
		_set_hints(trGetN.lowercuthint4, _L("Lower Cutoff in Hertz"), hertz);			
	///Jasmine 09/08/10 ORG-1004 GET_COVERTED_VALUE_ON_TYPE_CHANGE
	}
	if(dwCalculate & CALULATE_UPPER_CUTOFFVALUE)
	{
	///End GET_COVERTED_VALUE_ON_TYPE_CHANGE
		cutoff = trGetN.uppercut.dVal;
		_cutoff_conversion(cutoff, nSpeicifyCutoffBy,nRows, nCols, pixel,fraction, wavelength,hertz);	
		///Jasmine 09/08/10 ORG-1004 GET_COVERTED_VALUE_ON_TYPE_CHANGE
		s_uppercut.pixel 		= pixel;
		s_uppercut.fraction		= fraction;
		s_uppercut.wavelength	= wavelength;
		s_uppercut.hertz		= hertz;
		///End GET_COVERTED_VALUE_ON_TYPE_CHANGE
		
		_set_hints(trGetN.uppercuthint1, _L("Upper Cutoff in Pixels"), pixel);
				
		//_set_hints(trGetN.uppercuthint2, _L("Upper Cutoff in Fraction"), fraction);	///Jasminie 09/02/10 ORG-950-P2 HIDE_FRACTION_HINTS

		_set_hints(trGetN.uppercuthint3, _L("Upper Cutoff in Wavelength"), wavelength);	

		_set_hints(trGetN.uppercuthint4, _L("Upper Cutoff in Hertz"), hertz);
	}

}

///Jasmine 09/08/10 ORG-1004 GET_COVERTED_VALUE_ON_TYPE_CHANGE
static void _update_cutoff_value_on_type_change(TreeNode& trGetN)
{
	int nSpeicifyCutoffBy = trGetN.type.nVal;
	switch(nSpeicifyCutoffBy)
	{
	case type_fraction:
		trGetN.cutoff.dVal 	= s_cutoff.fraction;
		trGetN.lowercut.dVal= s_lowercut.fraction;
		trGetN.uppercut.dVal=s_uppercut.fraction;
		break;
	case type_pixel:
		trGetN.cutoff.dVal	= s_cutoff.pixel;
		trGetN.lowercut.dVal= s_lowercut.pixel;
		trGetN.uppercut.dVal=s_uppercut.pixel;
		break;
	case type_wavelength:
		trGetN.cutoff.dVal 	= s_cutoff.wavelength;
		trGetN.lowercut.dVal= s_lowercut.wavelength;
		trGetN.uppercut.dVal=s_uppercut.wavelength;
		break;
	case type_hertz:
		trGetN.cutoff.dVal	= s_cutoff.hertz;
		trGetN.lowercut.dVal= s_lowercut.hertz;
		trGetN.uppercut.dVal=s_uppercut.hertz;
		break;
	default:
		ASSERT(0);
		break;
	}			
}
///End GET_COVERTED_VALUE_ON_TYPE_CHANGE

///jasmine 08/09/10 ORG-389 ADD_MATRIX_IMAGE_PREVIEW
static int _fft_filter2(const MatrixObject& im, const int& nFilterType, const int& nWinType, 
				const int& nCutoffForm, const int& bZeroCut, const double& fCutoff, const int& nOrder, 
				const double& fLowerCutoff, const double& fUpperCutoff, 
				const double& fThresh1, const double& fThresh2, 
				MatrixObject& om)
{
	waitCursor junk;
	
	if( !im.IsValid() )
	{
		return XFERR_FFT_FILTER2_NO_INPUT_MATRIX;
	}
	
	int nRows = im.GetNumRows();
	int nCols = im.GetNumCols();	
		
	// Derek 7/26/2010 ORG-389-P1 RUNTIME_ERROR_WHEN_INPUT_MATRIX_DATA_TYPE_IS_NOT_DOUBLE_8
	//matrix &matIn = im.GetDataObject();
	matrix matIn = im.GetDataObject();
	// End RUNTIME_ERROR_WHEN_INPUT_MATRIX_DATA_TYPE_IS_NOT_DOUBLE_8
	
	om.SetInternalData(FSI_DOUBLE, false,false);
	om.SetSize(nRows,nCols,0);
	matrix &matOut = om.GetDataObject();
	
	int nRet;
	///Mori 10/29/2013 ORG-7535 UNAVAILABLE_BAND_PASS_AND_BLOCK_WHEN_BLACKMAN
	if(nWinType == window_blackman && (nFilterType == filter_bandpass || nFilterType == filter_bandblock))
		return XFERR_FFT_FILTER2_FAILED_TO_MAKE_FILTER;
	///End UNAVAILABLE_BAND_PASS_AND_BLOCK_WHEN_BLACKMAN
	if( nFilterType != filter_threshold )
	{
		matrix matFilter;
		double fCutoff1, fCutoff2;
		double pixel, fraction, wavelength, hertz;
		
		if( nFilterType == filter_low || nFilterType == filter_high )			
		{  
		    if( nCutoffForm == type_wavelength || nCutoffForm == type_hertz )
		    {
		    	_cutoff_conversion(fCutoff, nCutoffForm, nRows, nCols, pixel, fraction, wavelength, hertz);
		    	fCutoff1 = pixel;
		    }
		    else
		    {
		    	fCutoff1 = fCutoff;
		    }
			fCutoff2 = 0;    

		}
		
		if( nFilterType == filter_bandpass || nFilterType == filter_bandblock )
		{
	    
		    if( nCutoffForm == type_wavelength || nCutoffForm == type_hertz )
		    {
		    	_cutoff_conversion(fLowerCutoff, nCutoffForm, nRows, nCols, pixel, fraction, wavelength, hertz);
		    	fCutoff1 = pixel;
		    	
		    	_cutoff_conversion(fUpperCutoff, nCutoffForm, nRows, nCols, pixel, fraction, wavelength, hertz);
		    	fCutoff2 = pixel;
		    }	
		    else
		    {
		    	fCutoff1 = fLowerCutoff;
		    	fCutoff2 = fUpperCutoff;
		    }

		}
		int option = _option_conversion(nFilterType, nWinType, nCutoffForm, bZeroCut);		
		nRet = matFilter.FreqFilter(nRows, nCols, option, fCutoff1, nOrder, fCutoff2);
		if ( nRet < 0 )
			return XFERR_FFT_FILTER2_FAILED_TO_MAKE_FILTER;
	
		nRet = fft_band_filter_2D(matIn, matFilter, matOut);
		if ( nRet < 0 )
			return XFERR_FFT_FILTER2_FAILED_TO_DO_FILTERING;
	}
	else
	{
		nRet = fft_threshold_filter_2D(matIn, fThresh1, fThresh2, matOut);
		if ( nRet < 0 )
			return XFERR_FFT_FILTER2_FAILED_TO_DO_FILTERING;			
	}
	
	double xmin, ymin, xmax,ymax;
	im.GetXY(xmin, ymin, xmax, ymax);
	om.SetXY(xmin, ymin, xmax, ymax);
	
	return CER_NO_ERROR;
}
///End ADD_MATRIX_IMAGE_PREVIEW

void fft_filter2(const MatrixObject& im, const int& filter, const int& window, const int& zerocut, const int& order, const int& type, const double& cutoff, const string& cutoffhint1, const string& cutoffhint2, const string& cutoffhint3, const string& cutoffhint4, const double& lowercut, const string& lowercuthint1, const string& lowercuthint2, const string& lowercuthint3, const string& lowercuthint4, const double& uppercut, const string& uppercuthint1, const string& uppercuthint2, const string& uppercuthint3, const string& uppercuthint4, const double& lowerthre, const double& upperthre, MatrixObject& om)
{
	 	int nRet = _fft_filter2(	im, filter, window, type, zerocut, cutoff, order, 
								lowercut, uppercut, lowerthre, upperthre, om);
	
	if(nRet != CER_NO_ERROR)
		XF_THROW(nRet);
}

//nEventID < 0 on event, like GETNE_ON_INIT, GETNE_ON_OK etc, >0 on change from control
//return 0 to do nothing, return PEVENT_GETN_RET_TO_CLOSE to close dialog
//dwEnables = bOKEnable, bBTN1Enable, bBTN2Enable, bBTN3Enable, , can set to false to disable OK/Apply buttons
//lpcszNodeName = the trGetN TreeNode tag name that generates the event, or is  if GETNE_ON_OK etc
//strAux = optional string for XF Wizard Bar, like DLG_NEED_CHANGE_GRID etc, it will be invalid if from internal node value change event
//strErrMsg = allowing messages to be shown
int fft_filter2_event1(TreeNode& trGetN, int nRow, int nEventID, DWORD& dwEnables, LPCSTR lpcszNodeName, WndContainer& DynaCntrlContainer, string& strAux, string& strErrMsg)
{
	if( xf_is_extended_event(nEventID) )
		return fft_filter2_event1_ex(trGetN, nRow, nEventID, dwEnables, lpcszNodeName, DynaCntrlContainer, strAux, strErrMsg);
	DECLARE_BUTTON_ENABLES
	return false;

}

