// pgTemp is the graph for preview or control
// wksTemp is the the temp wks created to hold data to plot into pgTemp
static void GetNGraphPreview_OnInitGraph(TreeNode& trGetN, PageBase& pgTemp, Datasheet& wksTemp,
PictureControl& pict, // optional tab for showing an image or EMF, as requested in OnDialogSetup  
DWORD& dwUpdateGrid, // default to 0, set to UPDATE_GRID_SIMPLE to update the DynaControl grid, UPDATE_GRID_RESET to reset DynaControl grid
DWORD& dwEnables,// bOKEnable, bBTN1Enable, bBTN2Enable and bBTN3Enable :default to true, can set to false to disable buttons
string& strErrMsg) // optional err msg to be shown on dialog
{
	DECLARE_BUTTON_ENABLES
	DECLARE_UPDATE_GRID
	///jasmine 08/09/10 ORG-389 ADD_MATRIX_IMAGE_PREVIEW
	MatrixLayer mlTemp(wksTemp);
	if(mlTemp)
	{
		string strNoPreview = "No Preview.emf";
		string strPath;
		okutil_find_sys_path_with_file(&strPath, strNoPreview, GLOBAL_LOCALIZED_PATH, TRUE);
		
		MatrixObject mo = mlTemp.MatrixObjects();
		image_import_to_matrix(mo, strPath+strNoPreview);
	}
	///End ADD_MATRIX_IMAGE_PREVIEW
	
	strErrMsg = s_strErrMsg;	///Jasmine 08/26/10 ORG-389-P8 CHECK_ERROR_AT_THE_BEGINNING
}

///////////////////////////////////////////////////////

static void GetNGraphPreview_OnUpdateGraph(TreeNode& trGetN, PageBase& pgTemp, Datasheet& wksTemp, PictureControl& pict)
{
	///jasmine 08/09/10 ORG-389 ADD_MATRIX_IMAGE_PREVIEW
	MatrixObject im;
	if(!okxf_resolve_string_get_origin_object(trGetN.im.strVal, &im) )
		return; 
		
	MatrixObject om;
	MatrixLayer mlTemp(wksTemp);
	if(mlTemp)
		om = mlTemp.MatrixObjects();
	if(!om)
		return;
	
	int 	nFilterType	= trGetN.filter.nVal;
	int 	nWinType 	= trGetN.window.nVal;
	int 	nCutoffForm	= trGetN.type.nVal;
	int 	bZeroCut	= trGetN.zerocut.nVal;
	double 	fCutoff		= trGetN.cutoff.dVal;
	int 	nOrder 		= trGetN.order.nVal;
	double 	fLowerCutoff= trGetN.lowercut.dVal;
	double 	fUpperCutoff= trGetN.uppercut.dVal; 
	double 	fThresh1	= trGetN.lowerthre.dVal; 
	double 	fThresh2	= trGetN.upperthre.dVal; 
	
	
	int nRet = _fft_filter2(im, nFilterType, nWinType, nCutoffForm, bZeroCut, fCutoff, nOrder, 
					fLowerCutoff, fUpperCutoff, fThresh1, fThresh2, om);
	///End ADD_MATRIX_IMAGE_PREVIEW
}

///////////////////////////////////////////////////////

static void GetNGraphPreview_OnChange(TreeNode& trGetN, TreeNode& trNode, PageBase& pgTemp, Datasheet& wksTemp,
PictureControl& pict, // optional tab for showing an image or EMF that might be present, as requested in OnDialogSetup  
bool bChangedByGraph, // called when graph has been modified by user, like dragging a vertical line
DWORD& dwUpdateGraph,  // default to 0, UPDATE_GRAPH_CHANGED to cause graphs to be updated, UPDATE_GRAPH_INVALID to disable preview button
DWORD& dwUpdateGrid,  // default to 0, set to UPDATE_GRID_SIMPLE to update the DynaControl grid, UPDATE_GRID_RESET to reset DynaControl grid
DWORD& dwEnables,	// bOKEnable, bBTN1Enable, bBTN2Enable and bBTN3Enable :default to true, can set to false to disable buttons
string& strErrMsg) // optional err msg to be shown on dialog
{
	DECLARE_BUTTON_ENABLES
	DECLARE_UPDATE_GRAPH
	DECLARE_UPDATE_GRID
	_update_method_show(trGetN);
	
	///Jasmine 09/08/10 ORG-1004 GET_COVERTED_VALUE_ON_TYPE_CHANGE
	if(!trNode || ( trNode && lstrcmp(trNode.tagName, "im") == 0 ))
		_update_cutoff_hint_label(trGetN);	
	else if(trNode && lstrcmp(trNode.tagName, "cutoff") == 0)
		_update_cutoff_hint_label(trGetN, CALULATE_CUTOFFVALUE);	
	else if(trNode && lstrcmp(trNode.tagName, "lowercut") == 0)
		_update_cutoff_hint_label(trGetN, CALULATE_LOWER_CUTOFFVALUE);	
	else if(trNode && lstrcmp(trNode.tagName, "uppercut") == 0)
		_update_cutoff_hint_label(trGetN, CALULATE_UPPER_CUTOFFVALUE);
	else if(trNode && lstrcmp(trNode.tagName, "type") == 0)
		_update_cutoff_value_on_type_change(trGetN);
	
	bOKEnable = _check_input(trGetN, strErrMsg);
	///End GET_COVERTED_VALUE_ON_TYPE_CHANGE
	
	bUpdateGraph = bOKEnable;
}

