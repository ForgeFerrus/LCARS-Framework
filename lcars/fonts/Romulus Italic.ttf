static bool _update_axis_scrollbar(GraphLayer& gl, bool bAdd)
{
	if (bAdd)
	{
		XFBase xf("axis_scrollbar");	
		if( !xf )
			return false;
		/// Hong 08/02/07 QA80-9709-P11 FIX_FAIL_REMOVE_SCROLLBAR_IF_ACTIVE_LAYER_CHANGED
		xf.SetArg("layer", 1);
		/// end FIX_FAIL_REMOVE_SCROLLBAR_IF_ACTIVE_LAYER_CHANGED
		int nErr;
		xf.ExecuteLabTalk(NULL, NULL, NULL, 0, &nErr, 0);
	}
	else
	{
		remove_axis_scrollbar(gl);		
	}
	return true;
}

