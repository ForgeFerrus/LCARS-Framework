		{
			string strObjName = go.GetName();
			
			if ( 0 == strObjName.Find("pclamp_tag_line_") || 0 == strObjName.Find("pclamp_tag_text_") )
			{
				go.Show = trGetN.addtag.nVal;
			}
		}
		*/
		_update_tags(gp, trGetN);
		/// END ALLOW_TAG_TO_DYNAMIC_UPDATE
		/// Hong 07/30/07 QA80-9709-P11 v8.0671 SAVE_USER_OPERATION_FOR_CONTROL