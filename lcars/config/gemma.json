{
  "gemma": {
    "enabled": true,
    "default_model": "gemma4-9b",
    "available_models": [
      "gemma4-4b",
      "gemma4-9b",
      "gemma4-12b",
      "gemma4-26b"
    ],
    "default_mode": "passive",
    "thinking_enabled": false,
    "max_tokens": 1024,
    "temperature": 0.7,
    "top_p": 0.9,
    
    "integrator": {
      "auto_initialize": true,
      "system_prompt_file": "config/gemma_system_prompt.txt"
    },
    
    "controller": {
      "enable_command_validation": true,
      "max_concurrent_actions": 5,
      "require_confirmation_for": [
        "FILE_DELETE",
        "SYSTEM_REBOOT",
        "ALERT_RED"
      ]
    },
    
    "interpreter": {
      "project_root": ".",
      "allowed_commands": [
        "FILE_READ",
        "FILE_WRITE",
        "FILE_EDIT",
        "COMMAND",
        "ALERT",
        "UI_OPEN",
        "SCAN",
        "DIAG",
        "STATUS"
      ],
      "blocked_paths": [
        "/etc",
        "/sys",
        "/proc",
        "C:\\Windows\\System32"
      ],
      "command_timeout": 15
    },
    
    "chip": {
      "chip_id": "gemma_main",
      "database_path": "database/iso_chip_gemma.db",
      "faction": "Federation",
      "security_level": 2,
      "auto_insert": true
    },
    
    "ui": {
      "panel_enabled": true,
      "default_position": "right",
      "auto_open": false,
      "history_limit": 100
    },
    
    "telemetry": {
      "log_requests": true,
      "log_responses": true,
      "log_errors": true,
      "metrics_retention_days": 30
    }
  }
}