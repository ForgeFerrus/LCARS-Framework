{
  "GEANT4_PATH": "C:\\geant4",
  "env_vars": {
    "GEANT4_INSTALL": "C:\\geant4\\install",
    "GEANT4_INSTALL_DATA": "C:\\geant4\\data"
  },
  "projects": {
    "auto_discover": true,
    "default_build_type": "Release"
  },
  "ui": {
    "theme": "lcars",
    "window_width": 1920,
    "window_height": 1080,
    "default_faction": "Federation",
    "default_era": "25th",
    "hotkeys": {
      "toggle_lock": "Ctrl+L",
      "open_console": "Ctrl+`",
      "launch_engineering": "Ctrl+E"
    },
    "colors": {
      "alert_normal": "#FF9900",
      "alert_yellow": "#FFCC33",
      "alert_red": "#CC0000"
    }
  },
  "agent": {
    "allow_host_access": false,
    "host_whitelist": []
  }
}