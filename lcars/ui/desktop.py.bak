
LCARS Desktop shell for the LCARS Framework.
This file provides a simplified, robust `LCARSDesktop` QMainWindow
with Start Menu wiring, basic workspace management, shortcuts,
live-reload (F5), and non-blocking UI sounds.

The goal is to be concise and defensive so the project can start
and developers can iterate safely.
"""

import sys
import os
import json
import subprocess
import importlib
import random
from pathlib import Path
from datetime import datetime
from typing import Optional

from PyQt6.QtWidgets import (
    QApplication, QMainWindow, QWidget, QVBoxLayout, QHBoxLayout,
    QLabel, QPushButton, QFrame, QStackedWidget, QLineEdit, QTextEdit,
    QListWidget, QListWidgetItem
)
from PyQt6.QtGui import QKeySequence, QColor
from PyQt6.QtCore import Qt, QTimer, pyqtSignal, QUrl

# Optional: QShortcut may live in QtWidgets or QtGui depending on PyQt6 build
try:
    from PyQt6.QtWidgets import QShortcut
except Exception:
    try:
        from PyQt6.QtGui import QShortcut
    except Exception:
        QShortcut = None

# Optional sound support
try:
    from PyQt6.QtMultimedia import QSoundEffect
    QMUSIC_AVAILABLE = True
except Exception:
    QSoundEffect = None
    QMUSIC_AVAILABLE = False

# Project helpers
from lcars.system.paths import get_project_root, ensure_in_path, get_config_dir
from lcars.themes.lcars_palette import (
    LCARSEra, get_era_palette, get_random_button_color,
    get_lcars_font_style, setup_lcars_font
)
from lcars.ui.widgets import LCARSAppButton, LCARSDialog, LCARSElbow, LCARSFrame, LCARSDataBlock

# Optional modules used by features — imported lazily where needed

project_root = str(get_project_root())
ensure_in_path(project_root)


class LCARSDesktop(QMainWindow):
    """Simplified LCARS Desktop shell."""

    def __init__(self, embed: bool = False):
        super().__init__()
        self._embedded_mode = bool(embed)
        self.setWindowTitle("LCARS Operating System")
        self.setGeometry(0, 0, 1280, 800)
        if not self._embedded_mode:
            try:
                self.setWindowFlag(Qt.WindowType.FramelessWindowHint)
                self.setWindowState(Qt.WindowState.WindowFullScreen)
            except Exception:
                pass

        # Theme / palette
        self.current_era = LCARSEra.LCARS_25TH
        self.colors = get_era_palette(self.current_era)
        setup_lcars_font()

        # State
        self.workspace_pages = {}
        self.sounds_enabled = True
        self.sound_dir = Path(project_root) / "resources" / "sounds"
        self._sounds = {}

        # Basic UI
        self._build_ui()
        self._setup_shortcuts()

        # Timers
        self.clock_timer = QTimer(self)
        self.clock_timer.timeout.connect(self._update_clock)
        self.clock_timer.start(1000)

        # Load config
        cfg = get_config_dir()
        self.config_path = Path(cfg) / "desktop.json"
        self.desktop_state = {}
        self._load_config()

        # Post init
        QTimer.singleShot(200, self._restore_last_launch)

    # ---------- UI construction ----------
    def _build_ui(self):
        self.root = QWidget()
        self.setCentralWidget(self.root)
        
        main_layout = QVBoxLayout(self.root)
        main_layout.setContentsMargins(10, 10, 10, 10)
        main_layout.setSpacing(0)
        self.main_layout = main_layout

        # 1. TOP FRAME
        top_h = QHBoxLayout()
        top_h.setSpacing(0)
        
        # Top-Left Elbow
        self.tl_elbow = LCARSElbow(self.root, self.colors['button_colors'][0], "top-left", (140, 80))
        top_h.addWidget(self.tl_elbow)
        
        # Header Center Frame (Title Area)
        self.header_frame = QFrame()
        self.header_frame.setFixedHeight(50)
        self.header_frame.setStyleSheet(f"background-color: {self.colors['button_colors'][1]}; border-bottom-right-radius: 20px;")
        hf_lay = QHBoxLayout(self.header_frame)
        hf_lay.setContentsMargins(30, 0, 30, 0)
        
        title_lbl = QLabel("◢ LCARS PRIMARY COMMAND INTERFACE")
        title_lbl.setStyleSheet(f"color: #000; {get_lcars_font_style(20, 'normal')}")
        hf_lay.addWidget(title_lbl)
        hf_lay.addStretch()
        
        self.header_time = QLabel("00:00:00")
        self.header_time.setStyleSheet(f"color: #000; {get_lcars_font_style(22, 'normal')}")
        hf_lay.addWidget(self.header_time)
        
        top_h.addWidget(self.header_frame, 1)
        
        # Top-Right Elbow
        self.tr_elbow = LCARSElbow(self.root, self.colors['button_colors'][2], "top-right", (140, 80))
        top_h.addWidget(self.tr_elbow)
        
        main_layout.addLayout(top_h)

        # 2. MIDDLE SECTION (Peripheral verticals + Workspace)
        mid_h = QHBoxLayout()
        mid_h.setSpacing(10)
        
        # Left Vertical Frame (Tactical/Security stream)
        self.left_sidebar = QVBoxLayout()
        self.left_sidebar.setSpacing(5)
        self.left_sidebar.setContentsMargins(0, 0, 0, 0)
        
        self.left_frame_seg = LCARSFrame(self.colors['button_colors'][0], "vertical", length=400)
        self.left_sidebar.addWidget(self.left_frame_seg)
        
        # Add some data blocks to the sidebar
        self.data_blocks = []
        for label, dtype, color in [("CPU", "cpu", 5), ("MEM", "memory", 3), ("DSK", "disk", 2)]:
            block = LCARSDataBlock(label, "0%", self.colors['button_colors'][color], dtype)
            self.data_blocks.append(block)
            self.left_sidebar.addWidget(block)
            
        self.left_sidebar.addStretch()
        mid_h.addLayout(self.left_sidebar)

        # CENTER WORKSPACE
        self.center_stack = QStackedWidget()
        self.mission_hub = self.create_mission_hub()
        self.workspace = QStackedWidget()
        self.center_stack.addWidget(self.mission_hub)
        self.center_stack.addWidget(self.workspace)
        mid_h.addWidget(self.center_stack, 1)

        # Right Vertical Frame (Engineering/Comm stream)
        self.right_sidebar = QVBoxLayout()
        self.right_sidebar.setSpacing(5)
        
        self.right_frame_seg = LCARSFrame(self.colors['button_colors'][2], "vertical", length=300)
        self.right_sidebar.addWidget(self.right_frame_seg)
        
        # Add numeric blocks (decorative)
        for _ in range(8):
            num = random.randint(100, 9999)
            self.right_sidebar.addWidget(self.create_numeric_block(num, self.colors['button_colors'][random.randint(0,4)]))
            
        self.right_sidebar.addStretch()
        mid_h.addLayout(self.right_sidebar)
        
        main_layout.addLayout(mid_h, 1)

        # 3. BOTTOM FRAME
        bot_h = QHBoxLayout()
        bot_h.setSpacing(0)
        
        # Bottom-Left Elbow
        self.bl_elbow = LCARSElbow(self.root, self.colors['button_colors'][3], "bottom-left", (140, 80))
        bot_h.addWidget(self.bl_elbow)
        
        # Footer Action Frame
        self.footer_frame = QFrame()
        self.footer_frame.setFixedHeight(50)
        self.footer_frame.setStyleSheet(f"background-color: {self.colors['button_colors'][4]}; border-top-left-radius: 20px;")
        ff_lay = QHBoxLayout(self.footer_frame)
        ff_lay.setContentsMargins(20, 0, 20, 0)
        
        # Core controls in footer
        self.mod_btn = QPushButton("◢ MOD MODE")
        self.mod_btn.clicked.connect(self.toggle_mod_mode)
        
        self.red_alert_btn = QPushButton("◢ RED ALERT")
        self.red_alert_btn.clicked.connect(self.toggle_red_alert)
        
        self.lock_btn = QPushButton("◢ LOCK")
        self.lock_btn.clicked.connect(self.lock_screen)
        
        for b in [self.mod_btn, self.red_alert_btn, self.lock_btn]:
            b.setStyleSheet(f"background: transparent; color: #000; {get_lcars_font_style(16, 'normal')} border: none;")
            ff_lay.addWidget(b)
            
        ff_lay.addStretch()
        
        # System Uptime
        self.uptime_lbl = QLabel("UPTIME: 00:00")
        self.uptime_lbl.setStyleSheet(f"color: #000; {get_lcars_font_style(14, 'normal')}")
        ff_lay.addWidget(self.uptime_lbl)
        
        bot_h.addWidget(self.footer_frame, 1)
        
        # Bottom-Right Elbow
        self.br_elbow = LCARSElbow(self.root, self.colors['button_colors'][5], "bottom-right", (140, 80))
        bot_h.addWidget(self.br_elbow)
        
        main_layout.addLayout(bot_h)

    # (Rest of the file unchanged; omitted for brevity in this patch to keep focus on metrics removal)

    def launch_task_manager(self):
        """Embed the internal Task Manager / System Monitor widget."""
        try:
            from lcars.ui.lcars_central import get_central
            central = get_central()
            if central:
                central.launch_system_monitor()
                return
        except Exception:
            pass

        # fallback: previous local behavior
        try:
            from lcars.ui.system_monitor import SystemMonitorWidget

            widget = SystemMonitorWidget()
            self.add_workspace_widget("task_manager", widget, title="Task Manager")
        except Exception as e:
            print(f"Failed to launch Task Manager: {e}")
            self._show_placeholder("Task Manager")

    # ... (the rest of the file continues unchanged) ...

def main():
    app = QApplication(sys.argv)
    # Завантаження шрифтів
    setup_lcars_font()
    
    desktop = LCARSDesktop()
    desktop.show()
    sys.exit(app.exec())




