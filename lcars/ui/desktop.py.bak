    def launch_file_manager(self):
        """Embed the internal File Manager widget instead of external Explorer."""
        try:
            page = FileManagerWidget(start_path=project_root)
            self.add_workspace_widget("file_manager", page, title="File Manager")
        except Exception as e:
            print(f"Failed to open File Manager: {e}")
            self._show_placeholder("File Manager")

    def toggle_system_monitoring(self, event=None):
        """Toggle in-app system monitoring state and update UI."""
        try:
            from lcars.ui.lcars_central import get_central
            central = get_central()
            if central:
                central.toggle_monitoring()
                status = "ON" if getattr(central, "monitoring_active", False) else "OFF"
                self._show_notification(f"System monitoring {status} (central)")
                return
        except Exception:
            pass

        # fallback to previous local behavior
        self.monitor_active = not self.monitor_active
        status = "ON" if self.monitor_active else "OFF"
        self._show_notification(f"System monitoring {status}")
        print(f"LCARS: Real system monitoring {status}")

    def _flash_red_alert(self):
        """Повний RED ALERT - всі елементи використовують alert_colors, фон чорний"""
        self._red_state = not getattr(self, "_red_state", False)
        
        # Отримуємо alert_colors з поточної палітри
        alert_colors = self.colors['alert_colors']
        
        if self._red_state:
            # Яскравий червоний (перші кольори з alert_colors)
            primary_alert = alert_colors[0] if len(alert_colors) > 0 else "#FF0000"
            secondary_alert = alert_colors[1] if len(alert_colors) > 1 else "#AA0000"
        else:
            # Темніший червоний (середні кольори з alert_colors)
            primary_alert = alert_colors[3] if len(alert_colors) > 3 else "#AA0000"
            secondary_alert = alert_colors[4] if len(alert_colors) > 4 else "#880000"
        
        # Зберігаємо оригінальні кольори якщо ще не зберігали
        if not hasattr(self, '_original_colors'):
            self._original_colors = {}
            for btn_name in ['mod_btn', 'red_alert_btn', 'lock_btn']:
                if hasattr(self, btn_name):
                    btn = getattr(self, btn_name)
                    self._original_colors[btn_name] = btn.styleSheet()
        
        # Оновлюємо ВСІ кнопки і елементи
        elements_to_update = []
        
        # Кнопки в footer
    def _flash_red_alert(self):
        """Unified Red Alert: All frame elements and active widgets shift color."""
        self._red_state = not getattr(self, "_red_state", False)
        
        # Get alert colors from palette
        alert_colors = self.colors['alert_colors']
        
        if self._red_state:
            primary = alert_colors[0] if len(alert_colors) > 0 else "#FF0000"
            secondary = alert_colors[1] if len(alert_colors) > 1 else "#AA0000"
        else:
            primary = alert_colors[2] if len(alert_colors) > 2 else "#AA0000"
            secondary = alert_colors[3] if len(alert_colors) > 3 else "#880000"
        
        # Elements to update (Peripheral frame + Sidebar components)
        frame_elements = [
            'tl_elbow', 'tr_elbow', 'bl_elbow', 'br_elbow',
            'header_frame', 'footer_frame',
            'left_frame_seg', 'right_frame_seg'
        ]
        
        # Store original styles once for restoration
        if not hasattr(self, '_original_styles'):
            self._original_styles = {}
            for name in frame_elements:
                if hasattr(self, name):
                    self._original_styles[name] = getattr(self, name).styleSheet()
        
        # Apply alert colors to frame
        alert_style = f"background-color: {primary}; border: none;"
        for name in frame_elements:
            if hasattr(self, name):
                getattr(self, name).setStyleSheet(alert_style)
                # If it's an elbow, we update its internal color attribute
                element = getattr(self, name)
                if isinstance(element, LCARSElbow):
                    element.color = primary
                    element.update()

        # Update interactive buttons and data blocks
        for widget in self.root.findChildren((QPushButton, LCARSDataBlock)):
            if isinstance(widget, QPushButton):
                widget.setStyleSheet(f"""
                    QPushButton {{
                        background-color: {primary};
                        color: #FFF;
                        border: 2px solid {secondary};
                        {get_lcars_font_style(14, 'normal')}
                    }}
                """)
            elif isinstance(widget, LCARSDataBlock):
                widget.setStyleSheet(f"background-color: {primary}; border-radius: 5px;")
        
        # Ensure title and time are readable
        if hasattr(self, 'header_time'):
            self.header_time.setStyleSheet(f"color: #000; {get_lcars_font_style(22, 'normal')}")
        
        self.setStyleSheet("QMainWindow { background-color: #000000; }")

    def lock_screen(self):
        """Show lock screen using the dedicated lock_screen.py file"""
        if hasattr(self, '_locking') and self._locking:
            return
        
        self._locking = True
        print("Activating Lock Screen...")
        
        try:
            from lcars.ui.lock_screen import LCARSLockScreen
            
            if not hasattr(self, 'lock_screen_window') or self.lock_screen_window is None:
                self.lock_screen_window = LCARSLockScreen()
                self.lock_screen_window.unlocked.connect(self.unlock_screen)
            
            self.lock_screen_window.show()
            self.lock_screen_window.raise_()
            self.lock_screen_window.activateWindow()
        except Exception as e:
            print(f"Failed to show lock screen: {e}")
        finally:
            self._locking = False

    def unlock_screen(self):
        try:
            print("Screen Unlocked")
            if self.lock_screen_widget:
                self.lock_screen_widget.hide()
        except Exception as e:
            print(f"Failed to unlock screen: {e}")

    def refresh_system(self, event):
        """Force refresh system metrics (connected to Refresh button)"""
        try:
            # Prefer the available updater
            if hasattr(self, "update_system_metrics"):
                self.update_system_metrics()
            elif hasattr(self, "update_system_data"):
                self.update_system_data()
            self._show_notification("System refreshed")
        except Exception as e:
            print(f"Refresh error: {e}")

    def update_clock_and_status(self):
        """Update the header clock and optionally trigger status updates."""
        try:
            now = datetime.now()
            if hasattr(self, "header_time"):
                self.header_time.setText(now.strftime("%H:%M:%S"))
            # If monitoring is active, refresh metrics
            if getattr(self, "monitoring_active", False):
                if hasattr(self, "update_system_metrics"):
                    self.update_system_metrics()
                elif hasattr(self, "update_system_data"):
                    self.update_system_data()
        except Exception as e:
            print(f"Clock/status update error: {e}")

    def _show_notification(self, message):
        """Show system notification"""
        print(f"LCARS NOTIFICATION: {message}")
        try:
            from lcars.ui.communications import CommunicationsPanel

            widget = CommunicationsPanel()
            self.add_workspace_widget("communications", widget, title="Communications")
        except Exception as e:
            self._show_placeholder("Communications System")
            print(f"Communications system not available: {e}")

    def launch_monitor_toggle(self):
        """Toggle system monitor as overlay"""
        if hasattr(self, "monitor_active") and self.monitor_active:
            # Remove from workspace
            if "system_monitor" in self.workspace_pages:
                self.workspace.removeWidget(self.workspace_pages["system_monitor"])
                del self.workspace_pages["system_monitor"]
            self.monitor_active = False
        else:
            # Add to workspace
            self.launch_task_manager()
            self.monitor_active = True
        # monitor toggled

    # --- Application Launchers (Functional) ---
    def launch_cmd(self):
        import subprocess
        subprocess.Popen(["cmd.exe", "/k", "echo LCARS SHELL"])
    def launch_cmd(self):
        import subprocess
        subprocess.Popen(["cmd.exe"])

    def launch_powershell(self):
        import subprocess
        subprocess.Popen(["powershell.exe"])

    def launch_web_browser(self):
        import webbrowser
        webbrowser.open("https://www.google.com")

    def launch_text_editor(self):
        import subprocess
        subprocess.Popen(["notepad.exe"])

    def launch_calculator(self):
        import subprocess
        subprocess.Popen(["calc.exe"])

    def launch_control_panel(self):
        import subprocess
        subprocess.Popen(["control.exe"])

    def shutdown_system(self):
        import subprocess, sys
        if sys.platform == "win32":
            subprocess.Popen(["shutdown", "/s", "/t", "0"])
        else:
            subprocess.Popen(["shutdown", "-h", "now"])

    def restart_system(self):
        import subprocess, sys
        if sys.platform == "win32":
            subprocess.Popen(["shutdown", "/r", "/t", "0"])
        else:
            subprocess.Popen(["reboot"])

    def create_desktop_icon(self, file_path):
        from PyQt6.QtWidgets import QPushButton
        btn = QPushButton(f"📄\n{file_path.name[:10]}")
        btn.setFixedSize(100, 100)
        btn.setStyleSheet(f"background: {get_random_button_color(self.current_era)}; color: #000; {get_lcars_font_style(12)}")
        btn.clicked.connect(lambda: os.startfile(file_path) if sys.platform == "win32" else subprocess.Popen(["open", str(file_path)]))
        return btn

    def brighten_color(self, color):
        c = QColor(color)
        return c.lighter(120).name()

    def darken_color(self, color):
        c = QColor(color)
        return c.darker(120).name()


# --- LCARS IDE (Mod Mode Component) ---
class LCARS_IDE(QWidget):
    """Integrated Development Environment for LCARS Framework"""
    def __init__(self, start_path=None, parent=None):
        super().__init__(parent)
        self.project_root = Path(start_path) if start_path else Path.cwd()
        self.setup_ui()

    def setup_ui(self):
        layout = QHBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(10)

        # 1. Left Sidebar: File Explorer
        self.explorer = FileManagerWidget(start_path=self.project_root, embed_mode=True)
        self.explorer.setFixedWidth(300)
        layout.addWidget(self.explorer)

        # 2. Center: Code Editor & Terminal
        center_v = QVBoxLayout()
        center_v.setSpacing(10)

        # Editor
        self.editor = QTextEdit()
        self.editor.setPlaceholderText("SYSTEM CODE EDITOR - READY")
        self.editor.setStyleSheet(f"""
            QTextEdit {{
                background-color: #050505;
                color: #37A6D1;
                border: 2px solid #2F3749;
                border-radius: 10px;
                padding: 10px;
                {get_lcars_font_style(28, 'normal')}
            }}
        """)
        center_v.addWidget(self.editor, 3)

        # Actions Line
        actions = QHBoxLayout()
        self.save_btn = QPushButton("SAVE SOURCE")
        self.save_btn.setFixedHeight(40)
        self.save_btn.setStyleSheet(f"""
            QPushButton {{
                background-color: {get_random_button_color(LCARSEra.LCARS_25TH)};
                color: #000;
                border-radius: 10px;
                {get_lcars_font_style(18, 'normal')}
            }}
        """)
        self.save_btn.clicked.connect(self.save_file)
        actions.addWidget(self.save_btn)
        actions.addStretch()
        center_v.addLayout(actions)

        # Terminal
        self.terminal = LCARSDesktop._TerminalWidget()
        center_v.addWidget(self.terminal, 1)

        layout.addLayout(center_v)
        
        # Connect explorer to editor
        self.explorer.file_selected.connect(self.load_file_to_editor)

    def load_file_to_editor(self, path):
        self.current_file = Path(path)
        try:
            with open(path, 'r', encoding='utf-8', errors='ignore') as f:
                self.editor.setPlainText(f.read())
        except Exception as e:
            self.editor.setPlainText(f"ERROR_LOADING_FILE: {e}")

    def save_file(self):
        if not hasattr(self, 'current_file') or not self.current_file:
            return
        try:
            with open(self.current_file, 'w', encoding='utf-8') as f:
                f.write(self.editor.toPlainText())
            self.save_btn.setText("SAVED ✓")
            QTimer.singleShot(2000, lambda: self.save_btn.setText("SAVE SOURCE"))
        except Exception as e:
            LCARSDialog.show_message(self, "Save Error", f"Failed to save file: {e}")

class FileManagerWidget(QWidget):
    """Global LCARS File Manager with Drive Navigation and Internal Launching"""
    file_selected = pyqtSignal(str)

    def __init__(self, start_path=None, parent=None, embed_mode=False):
        super().__init__(parent)
        self.current_path = Path(start_path) if start_path else Path.cwd()
        self.colors = get_era_palette(LCARSEra.LCARS_25TH)
        self.setup_ui()
        self.load_path(self.current_path)

    def setup_ui(self):
        layout = QHBoxLayout(self)
        layout.setContentsMargins(10, 10, 10, 10)
        layout.setSpacing(20)

        # 1. Drive/Quick Access Sidebar
        sidebar = QVBoxLayout()
        sidebar.setSpacing(10)
        
        # Drive Buttons
        import string
        from ctypes import windll
        if sys.platform == "win32":
            drives = []
            bitmask = windll.kernel32.GetLogicalDrives()
            for letter in string.ascii_uppercase:
                if bitmask & 1: drives.append(letter + ":\\")
                bitmask >>= 1
            for d in drives:
                btn = self.create_nav_btn(d, self.colors['button_colors'][0])
                btn.clicked.connect(lambda checked, p=d: self.load_path(Path(p)))
                sidebar.addWidget(btn)
        
        home_btn = self.create_nav_btn("HOME", self.colors['button_colors'][2])
        home_btn.clicked.connect(lambda: self.load_path(Path.home()))
        sidebar.addWidget(home_btn)
        
        sidebar.addStretch()
        layout.addLayout(sidebar)

        # 2. Main Area (Path + List)
        main_v = QVBoxLayout()
        
        # Path Bar
        path_row = QHBoxLayout()
        self.path_edit = QLineEdit(str(self.current_path))
        self.path_edit.setStyleSheet(f"background: #0A0E1A; color: #FFFFFF; border-radius: 10px; padding: 10px; {get_lcars_font_style(20)}")
        path_row.addWidget(self.path_edit, 1)
        
        up_btn = QPushButton("UP")
        up_btn.setFixedSize(80, 45)
        up_btn.setStyleSheet(f"background: {self.colors['button_colors'][1]}; color: #000; border-radius: 5px; {get_lcars_font_style(18)}")
        up_btn.clicked.connect(self.go_up)
        path_row.addWidget(up_btn)
        
        main_v.addLayout(path_row)

        # List
        self.listw = QListWidget()
        self.listw.setStyleSheet(f"""
            QListWidget {{
                background-color: #050505;
                color: #FFFFFF;
                border: 2px solid #2F3749;
                border-radius: 15px;
                padding: 10px;
                {get_lcars_font_style(18, 'normal')}
            }}
            QListWidget::item {{ padding: 8px; }}
            QListWidget::item:selected {{ background-color: {self.colors['button_colors'][1]}; color: #000; }}
        """)
        self.listw.itemDoubleClicked.connect(self.on_item_activated)
        main_v.addWidget(self.listw)
        
        layout.addLayout(main_v, 1)

    def create_nav_btn(self, text, color):
        btn = QPushButton(text)
        btn.setFixedSize(100, 50)
        btn.setStyleSheet(f"background: {color}; color: #000; border-radius: 5px; {get_lcars_font_style(18, 'normal')}")
        return btn

    def load_path(self, path: Path):
        try:
            self.current_path = Path(path)
            self.path_edit.setText(str(self.current_path))
            self.listw.clear()
            for e in sorted(self.current_path.iterdir(), key=lambda x: (not x.is_dir(), x.name.lower())):
                prefix = "◢ " if e.is_dir() else "  "
                item = QListWidgetItem(f"{prefix}{e.name.upper()}")
                item.setData(Qt.ItemDataRole.UserRole, str(e))
                self.listw.addItem(item)
        except Exception as e:
            print(f"Path access error: {e}")

    def go_up(self): self.load_path(self.current_path.parent)

    def on_item_activated(self, item):
        path = Path(item.data(Qt.ItemDataRole.UserRole))
        if path.is_dir():
            self.load_path(path)
        else:
            self.launch_file(path)

    def launch_file(self, path):
        """Internal file launch logic"""
        ext = path.suffix.lower()
        if ext in ('.py', '.txt', '.log', '.json', '.md'):
            try:
                # Open with notepad or similar via subprocess
                subprocess.Popen(["notepad.exe", str(path)])
            except:
                os.startfile(str(path))
        else:
            try:
                os.startfile(str(path))
            except Exception as e:
                print(f"Failed to launch file: {e}")

def main():
    app = QApplication(sys.argv)
    # Завантаження шрифтів
    setup_lcars_font()
    
    desktop = LCARSDesktop()
    desktop.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
