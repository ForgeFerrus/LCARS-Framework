# LCARS Framework Configuration

## Default environment settings
GEANT4_PATH=/path/to/geant4
GEANT4_INSTALL=/path/to/geant4/install
GEANT4_INSTALL_DATA=/path/to/geant4/data

## Application settings
LOG_LEVEL=INFO
DEBUG_MODE=False

## Framework settings
AUTO_DISCOVER_PROJECTS=True
PROJECT_EXTENSIONS=cc,C,cpp

# AI provider keys (do NOT commit .env)
OPENAI_API_KEY=
HUGGINGFACE_API_TOKEN=
LCARS_AGENT_AUTHORITY=FULL
