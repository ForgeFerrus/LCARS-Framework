<Window x:Class="LCARSWorkbench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lcars="clr-namespace:LCARSFramework.Control"
        Title="LCARS Workbench" Width="980" Height="620" Background="Black">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Style/Base.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar: faction + era selection -->
        <StackPanel Grid.Column="0" Margin="8" Background="Black">
            <TextBlock Text="FACTION" Style="{StaticResource LCARS.Text}" Margin="4"/>
            <ListBox x:Name="FactionList" Margin="4" SelectedIndex="0">
                <ListBoxItem>Federation</ListBoxItem>
                <ListBoxItem>Romulan</ListBoxItem>
                <ListBoxItem>Klingon</ListBoxItem>
                <ListBoxItem>Cardassian</ListBoxItem>
            </ListBox>

            <TextBlock Text="ERA" Style="{StaticResource LCARS.Text}" Margin="12,8,4,4"/>
            <ComboBox x:Name="EraComboBox" Margin="4" SelectedIndex="2">
                <ComboBoxItem>Era22</ComboBoxItem>
                <ComboBoxItem>Era23</ComboBoxItem>
                <ComboBoxItem>Era24</ComboBoxItem>
                <ComboBoxItem>Era25</ComboBoxItem>
                <ComboBoxItem>Era26</ComboBoxItem>
                <ComboBoxItem>Era27</ComboBoxItem>
                <ComboBoxItem>Era28</ComboBoxItem>
                <ComboBoxItem>Era29</ComboBoxItem>
                <ComboBoxItem>Era30</ComboBoxItem>
            </ComboBox>

            <Button x:Name="LauncherButton" Content="Open Launcher" Width="200" Margin="8" Click="OnOpenLauncher"/>
        </StackPanel>

        <!-- Main area: preview / controls -->
        <Grid Grid.Column="1" Margin="12">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
                <lcars:LCARSButton x:Name="ActivateButton" Label="ACTIVATE" Width="200" Height="44"/>
                <TextBlock Text="Preview & controls" Style="{StaticResource LCARS.Text}" Margin="6"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
