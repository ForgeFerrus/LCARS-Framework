<UserControl x:Class="LCARSFramework.Control.LCARSButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Width="200" Height="44">
    <Button x:Name="InnerButton" Background="Transparent" BorderThickness="0" Click="InnerButton_Click"
            Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            PreviewMouseLeftButtonDown="InnerButton_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="InnerButton_PreviewMouseLeftButtonUp"
            MouseEnter="InnerButton_MouseEnter" MouseLeave="InnerButton_MouseLeave">
        <Border x:Name="ButtonBorder"
              CornerRadius="0,20,20,0"
              Background="{StaticResource LCARS.Orange}"
              BorderBrush="#222"
              BorderThickness="2"
              Padding="6">
            <TextBlock Text="{Binding ElementName=Root, Path=Label}"
                   Style="{StaticResource LCARS.Text}"
                   Foreground="Black"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        </Border>
    </Button>
</UserControl>

