<Window x:Class="LCARSWorkbench.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lcars="clr-namespace:LCARSFramework.Control"
        Title="LCARS Launcher" WindowStyle="None" WindowState="Maximized" Background="Black">
    <Grid>
        <!-- Outer LCARS frame bar -->
        <Border Background="#111" Height="48" VerticalAlignment="Top">
            <TextBlock Text="LCARS Launcher" Foreground="White" VerticalAlignment="Center" Margin="16" FontWeight="Bold"/>
        </Border>

        <Grid Margin="24,72,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left pane: selectors -->
            <StackPanel Grid.Column="0" Margin="8" VerticalAlignment="Top">
                <TextBlock Text="FACTION" Style="{StaticResource LCARS.Text}" Margin="4"/>
                <StackPanel Orientation="Vertical" Margin="4" x:Name="FactionButtons">
                    <lcars:LCARSButton Label="Federation" Width="240" Height="40" Margin="4" Click="FactionSelect_Click"/>
                    <lcars:LCARSButton Label="Romulan" Width="240" Height="40" Margin="4" Click="FactionSelect_Click"/>
                    <lcars:LCARSButton Label="Klingon" Width="240" Height="40" Margin="4" Click="FactionSelect_Click"/>
                    <lcars:LCARSButton Label="Cardassian" Width="240" Height="40" Margin="4" Click="FactionSelect_Click"/>
                </StackPanel>

                <TextBlock Text="ERA" Style="{StaticResource LCARS.Text}" Margin="12,12,4,4"/>
                <StackPanel Orientation="Vertical" Margin="4" x:Name="EraButtons">
                    <lcars:LCARSButton Label="Era22" Width="240" Height="34" Margin="4" Click="EraSelect_Click"/>
                    <lcars:LCARSButton Label="Era23" Width="240" Height="34" Margin="4" Click="EraSelect_Click"/>
                    <lcars:LCARSButton Label="Era24" Width="240" Height="34" Margin="4" Click="EraSelect_Click"/>
                    <lcars:LCARSButton Label="Era25" Width="240" Height="34" Margin="4" Click="EraSelect_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="8,16,4,4">
                    <lcars:LCARSButton Label="OK" Width="110" Height="40" Margin="4" Click="OnOk_Click"/>
                    <lcars:LCARSButton Label="Cancel" Width="110" Height="40" Margin="4" Click="OnCancel_Click"/>
                </StackPanel>

                <lcars:LCARSButton Label="Build Theme DLL" Width="240" Height="36" Margin="8" Click="OnBuildThemeDll_Click"/>

                <TextBlock x:Name="StatusText" Text="" Foreground="White" Margin="8,12,4,4" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Right pane: preview canvas and large activate -->
            <Grid Grid.Column="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <lcars:LCARSButton x:Name="LauncherActivate" Label="ACTIVATE" Width="320" Height="56" HorizontalAlignment="Center" Margin="0,8,0,8"/>

                <Grid Grid.Row="1">
                    <Border BorderBrush="#333" BorderThickness="4" CornerRadius="8" Background="#000" Padding="12">
                        <lcars:LCARSMenu x:Name="LauncherPreview" Width="600" Height="420"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>