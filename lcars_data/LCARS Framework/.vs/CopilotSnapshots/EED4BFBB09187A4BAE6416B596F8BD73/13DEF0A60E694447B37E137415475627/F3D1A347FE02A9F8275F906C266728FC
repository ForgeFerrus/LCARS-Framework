<UserControl x:Class="LCARSFramework.Control.LCARSButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Width="200" Height="44">
    <Grid>
        <Border x:Name="ButtonBorder"
                CornerRadius="12"
                Background="{StaticResource LCARS.ButtonGradient}"
                BorderBrush="#333"
                BorderThickness="2"
                Padding="6">
            <TextBlock Text="{Binding ElementName=Root, Path=Label}"
                       Style="{StaticResource LCARS.Text}"
                       Foreground="Black"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>
        <!-- Transparent overlay button to receive input and forward events to code-behind -->
        <Button Background="Transparent" BorderThickness="0"
                Click="InnerButton_Click"
                PreviewMouseLeftButtonDown="InnerButton_PreviewMouseLeftButtonDown"
                PreviewMouseLeftButtonUp="InnerButton_PreviewMouseLeftButtonUp"
                MouseEnter="InnerButton_MouseEnter"
                MouseLeave="InnerButton_MouseLeave"/>
    </Grid>
</UserControl>

