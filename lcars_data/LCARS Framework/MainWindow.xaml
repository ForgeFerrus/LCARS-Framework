<Window x:Class="LCARSWorkbench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lcars="clr-namespace:LCARSFramework.Control"
        Title="LCARS Workbench" Width="1286" Height="967" Background="Black"
        WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Style/Base.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="234.352"/>
            <ColumnDefinition Width="25.648"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar: faction + era selection -->
        <StackPanel Grid.Column="0" Margin="8,8,8,8" Grid.ColumnSpan="2">
            <TextBlock Text="FACTION" Style="{StaticResource LCARS.Text}" Margin="4"/>
            <StackPanel x:Name="FactionButtons" Margin="4">
                <lcars:LCARSButton x:Name="BtnFederation" Label="Federation" Width="220" Height="34" Margin="4" Click="FactionButton_Click"/>
                <lcars:LCARSButton x:Name="BtnRomulan" Label="Romulan" Width="220" Height="34" Margin="4" Click="FactionButton_Click"/>
                <lcars:LCARSButton x:Name="BtnKlingon" Label="Klingon" Width="220" Height="34" Margin="4" Click="FactionButton_Click"/>
                <lcars:LCARSButton x:Name="BtnCardassian" Label="Cardassian" Width="220" Height="34" Margin="4" Click="FactionButton_Click"/>
            </StackPanel>

            <TextBlock Text="ERA" Style="{StaticResource LCARS.Text}" Margin="12,8,4,4"/>
            <StackPanel x:Name="EraButtons" Margin="4" Orientation="Vertical">
                <lcars:LCARSButton Label="Era22" Width="220" Height="28" Margin="4" Click="EraButton_Click"/>
                <lcars:LCARSButton Label="Era23" Width="220" Height="28" Margin="4" Click="EraButton_Click"/>
                <lcars:LCARSButton Label="Era24" Width="220" Height="28" Margin="4" Click="EraButton_Click"/>
                <lcars:LCARSButton Label="Era25" Width="220" Height="28" Margin="4" Click="EraButton_Click"/>
                <lcars:LCARSButton Label="Era26" Width="220" Height="28" Margin="4" Click="EraButton_Click"/>
                <lcars:LCARSButton Label="Era27" Width="220" Height="28" Margin="4" Click="EraButton_Click"/>
                <lcars:LCARSButton Label="Era28" Width="220" Height="28" Margin="4" Click="EraButton_Click"/>
                <lcars:LCARSButton Label="Era29" Width="220" Height="28" Margin="4" Click="EraButton_Click"/>
                <lcars:LCARSButton Label="Era30" Width="220" Height="28" Margin="4" Click="EraButton_Click"/>
            </StackPanel>

            <Button x:Name="LauncherButton" Content="Open Launcher" Width="200" Margin="8" Click="OnOpenLauncher"/>

            <TextBlock Text="Preview Menu" Style="{StaticResource LCARS.Text}" Margin="8,16,4,4"/>
            <lcars:LCARSMenu x:Name="PreviewMenu" Width="240" Height="240"/>
        </StackPanel>

        <!-- Main area: preview / controls -->
        <Grid Grid.Column="2" Margin="12,12,12,12">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
                <lcars:LCARSButton x:Name="ActivateButton" Label="ACTIVATE" Width="158" Height="35"/>
                <TextBlock Text="Preview &amp; controls" Style="{StaticResource LCARS.Text}" Margin="6"/>
                <lcars:LCARSPanel x:Name="SamplePanel" Margin="6"/>
                <StackPanel Orientation="Horizontal" Margin="6">
                    <lcars:LCARSRib x:Name="SampleRib" Margin="6"/>
                    <lcars:LCARSComb x:Name="SampleComb" Margin="6"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
