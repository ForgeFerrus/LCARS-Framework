<UserControl x:Class="LCARSFramework.Control.LCARSPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Width="300" Height="160">
    <Border x:Name="PanelBorder" CornerRadius="12" BorderThickness="2" Padding="8" Background="Black" BorderBrush="#222">
        <StackPanel>
            <TextBlock x:Name="PanelLabel" Text="PANEL" Style="{StaticResource LCARS.Text}" FontSize="16"/>
            <TextBlock x:Name="PanelMeta" Text="Faction / Era" Style="{StaticResource LCARS.Text}" FontSize="12" Opacity="0.8"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Action" Width="80" Margin="4"/>
                <Button Content="Toggle" Width="80" Margin="4"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>