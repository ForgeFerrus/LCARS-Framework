<UserControl x:Class="LCARSFramework.Control.LCARSComb"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Width="180" Height="60">
    <Border x:Name="CombBorder" CornerRadius="6" BorderThickness="2" Padding="6" Background="Black" BorderBrush="#222">
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="CombLabel" Text="COMB" Style="{StaticResource LCARS.Text}"/>
        </StackPanel>
    </Border>
</UserControl>