{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Test Current File",
      "type": "python",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONUNBUFFERED": "1",
        "LCARS_DEV_MODE": "1"
      }
    },
    {
      "name": "Python: Debug Current File",
      "type": "python",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONUNBUFFERED": "1",
        "LCARS_DEBUG": "1"
      },
      "stopOnEntry": false
    },
    {
      "name": "Python: Run Module",
      "type": "python",
      "request": "launch",
      "module": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
