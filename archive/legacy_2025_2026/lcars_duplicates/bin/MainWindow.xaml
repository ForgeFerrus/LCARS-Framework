<Window x:Class="LCARS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LCARS"
        mc:Ignorable="d"
        Title="LCARS Prototype" Height="800" Width="1200" 
        Background="Black" WindowStyle="None" WindowState="Maximized">

    <Window.Resources>
        <!-- LCARS Brushes -->
        <SolidColorBrush x:Key="LCARS.Black" Color="#000000"/>
        <SolidColorBrush x:Key="LCARS.White" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="LCARS.Orange" Color="#FF9900"/>
        <SolidColorBrush x:Key="LCARS.Blue" Color="#3399FF"/>
        <SolidColorBrush x:Key="LCARS.Cyan" Color="#33CCFF"/>
        <SolidColorBrush x:Key="LCARS.Magenta" Color="#FF33CC"/>
        <SolidColorBrush x:Key="LCARS.Red" Color="#CC0000"/>
        <SolidColorBrush x:Key="LCARS.Yellow" Color="#FFCC66"/>
        
        <!-- LCARS Button Style -->
        <Style x:Key="LCARSButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource LCARS.Orange}"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{StaticResource LCARS.Orange}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="BorderBrush" Value="White"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FFAA00"/>
                    <Setter Property="BorderBrush" Value="#FFAA00"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- LCARS Text Style -->
        <Style x:Key="LCARSTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource LCARS.White}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" 
                Background="{StaticResource LCARS.Orange}" 
                CornerRadius="10,10,0,0" Margin="5,5,5,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="◤ LCARS PROTOTYPE" Style="{StaticResource LCARSTextStyle}" 
                          FontSize="24" Foreground="Black"/>
                <TextBlock Text="SYSTEM STATUS: ONLINE" Style="{StaticResource LCARSTextStyle}" 
                          FontSize="18" Foreground="Black" Margin="50,0,0,0"/>
                <TextBlock x:Name="TimeDisplay" Text="00:00:00" Style="{StaticResource LCARSTextStyle}" 
                          FontSize="18" Foreground="Black" Margin="50,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Left Sidebar -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="5,10,5,10">
            <TextBlock Text="SYSTEM" Style="{StaticResource LCARSTextStyle}" Margin="5"/>
            <Button Content="DASHBOARD" Style="{StaticResource LCARSButtonStyle}" 
                   Height="40" Margin="5" Click="Dashboard_Click"/>
            <Button Content="SENSORS" Style="{StaticResource LCARSButtonStyle}" 
                   Background="{StaticResource LCARS.Yellow}" BorderBrush="{StaticResource LCARS.Yellow}"
                   Height="40" Margin="5" Click="Sensors_Click"/>
            <Button Content="SYSTEMS" Style="{StaticResource LCARSButtonStyle}" 
                   Background="{StaticResource LCARS.Blue}" BorderBrush="{StaticResource LCARS.Blue}"
                   Height="40" Margin="5" Click="Systems_Click"/>
            <Button Content="LOGISTICS" Style="{StaticResource LCARSButtonStyle}" 
                   Background="{StaticResource LCARS.Cyan}" BorderBrush="{StaticResource LCARS.Cyan}"
                   Height="40" Margin="5" Click="Logistics_Click"/>
            
            <TextBlock Text="OPERATIONS" Style="{StaticResource LCARSTextStyle}" Margin="5,20,5,5"/>
            <Button Content="TACTICAL" Style="{StaticResource LCARSButtonStyle}" 
                   Background="{StaticResource LCARS.Red}" BorderBrush="{StaticResource LCARS.Red}"
                   Height="40" Margin="5" Click="Tactical_Click"/>
            <Button Content="SHIELDS" Style="{StaticResource LCARSButtonStyle}" 
                   Height="40" Margin="5" Click="Shields_Click"/>
            <Button Content="WEAPONS" Style="{StaticResource LCARSButtonStyle}" 
                   Height="40" Margin="5" Click="Weapons_Click"/>
            
            <Button Content="EXIT" Style="{StaticResource LCARSButtonStyle}" 
                   Background="#444" BorderBrush="#444"
                   Height="40" Margin="5,50,5,5" Click="Exit_Click"/>
        </StackPanel>

        <!-- Main Content Area -->
        <Border Grid.Row="1" Grid.Column="1" 
                BorderBrush="{StaticResource LCARS.Orange}" 
                BorderThickness="2" CornerRadius="10" Margin="10">
            <Grid x:Name="MainContent">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="◤ LCARS MAIN INTERFACE ◤" 
                              Style="{StaticResource LCARSTextStyle}" 
                              FontSize="32" Foreground="{StaticResource LCARS.Orange}"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="SYSTEM READY" 
                              Style="{StaticResource LCARSTextStyle}" 
                              FontSize="20" Foreground="{StaticResource LCARS.White}"
                              HorizontalAlignment="Center" Margin="0,20,0,0"/>
                    
                    <!-- Quick Access Grid -->
                    <Grid Margin="0,40,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <Button Grid.Row="0" Grid.Column="0" Content="MISSION" 
                               Style="{StaticResource LCARSButtonStyle}" 
                               Background="{StaticResource LCARS.Red}" BorderBrush="{StaticResource LCARS.Red}"
                               Height="60" Width="150" Margin="10" Click="Mission_Click"/>
                        <Button Grid.Row="0" Grid.Column="1" Content="SCIENCE" 
                               Style="{StaticResource LCARSButtonStyle}" 
                               Background="{StaticResource LCARS.Yellow}" BorderBrush="{StaticResource LCARS.Yellow}"
                               Height="60" Width="150" Margin="10" Click="Science_Click"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="COMMS" 
                               Style="{StaticResource LCARSButtonStyle}" 
                               Background="{StaticResource LCARS.Magenta}" BorderBrush="{StaticResource LCARS.Magenta}"
                               Height="60" Width="150" Margin="10" Click="Comms_Click"/>
                        <Button Grid.Row="1" Grid.Column="0" Content="ENGINEERING" 
                               Style="{StaticResource LCARSButtonStyle}" 
                               Background="{StaticResource LCARS.Blue}" BorderBrush="{StaticResource LCARS.Blue}"
                               Height="60" Width="150" Margin="10" Click="Engineering_Click"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="MEDICAL" 
                               Style="{StaticResource LCARSButtonStyle}" 
                               Background="{StaticResource LCARS.Cyan}" BorderBrush="{StaticResource LCARS.Cyan}"
                               Height="60" Width="150" Margin="10" Click="Medical_Click"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="COMMAND" 
                               Style="{StaticResource LCARSButtonStyle}" 
                               Height="60" Width="150" Margin="10" Click="Command_Click"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right Status Panel -->
        <StackPanel Grid.Row="1" Grid.Column="2" Margin="5,10,5,10">
            <TextBlock Text="SYSTEM STATUS" Style="{StaticResource LCARSTextStyle}" Margin="5"/>
            <Border Background="#111" BorderBrush="{StaticResource LCARS.Orange}" 
                   BorderThickness="1" CornerRadius="5" Margin="5" Padding="10">
                <StackPanel>
                    <TextBlock Text="POWER: 100%" Style="{StaticResource LCARSTextStyle}" FontSize="12"/>
                    <ProgressBar Value="100" Height="10" Margin="0,5" Foreground="{StaticResource LCARS.Orange}"/>
                    <TextBlock Text="SHIELDS: 100%" Style="{StaticResource LCARSTextStyle}" FontSize="12"/>
                    <ProgressBar Value="100" Height="10" Margin="0,5" Foreground="{StaticResource LCARS.Blue}"/>
                    <TextBlock Text="WEAPONS: READY" Style="{StaticResource LCARSTextStyle}" FontSize="12"/>
                    <ProgressBar Value="100" Height="10" Margin="0,5" Foreground="{StaticResource LCARS.Red}"/>
                </StackPanel>
            </Border>
            
            <TextBlock Text="ALERT STATUS" Style="{StaticResource LCARSTextStyle}" Margin="5,20,5,5"/>
            <Button Content="GREEN ALERT" Style="{StaticResource LCARSButtonStyle}" 
                   Background="{StaticResource LCARS.Cyan}" BorderBrush="{StaticResource LCARS.Cyan}"
                   Height="35" Margin="5" Click="GreenAlert_Click"/>
            <Button Content="YELLOW ALERT" Style="{StaticResource LCARSButtonStyle}" 
                   Background="{StaticResource LCARS.Yellow}" BorderBrush="{StaticResource LCARS.Yellow}"
                   Height="35" Margin="5" Click="YellowAlert_Click"/>
            <Button Content="RED ALERT" Style="{StaticResource LCARSButtonStyle}" 
                   Background="{StaticResource LCARS.Red}" BorderBrush="{StaticResource LCARS.Red}"
                   Height="35" Margin="5" Click="RedAlert_Click"/>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" 
                Background="{StaticResource LCARS.Orange}" 
                CornerRadius="0,0,10,10" Margin="5,0,5,5">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <Button Content="ACCESS" Style="{StaticResource LCARSButtonStyle}" 
                       Width="150" Height="35" Margin="0,0,20,0" Click="Access_Click"/>
                <TextBlock Text="► ALL SYSTEMS NOMINAL ◄" Style="{StaticResource LCARSTextStyle}" 
                          FontSize="14" Foreground="Black"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
